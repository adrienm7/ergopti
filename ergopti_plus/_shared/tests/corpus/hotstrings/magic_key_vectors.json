		},
		{ "id": "char-alone", "char": "ù", "text": "★", "expected": "★ (ù)" },
		{ "id": "percent-char", "char": "%", "text": "Aperçu ★", "expected": "Aperçu ★ (%)" },
		{
			"id": "no-marker",
			"char": "ù",
