	"answers": [
		{
			"name": "a token and its lifetime",
			"block": "ibm",
			"status": 200,
			"json": { "access_token": "eyJ.token", "expires_in": 3600, "token_type": "Bearer" },
			"now": 1000,
			"token": "eyJ.token",
			"expires_at": 4600
		},
		{
			"name": "no lifetime takes the default",
			"block": "google",
			"status": 200,
			"json": { "access_token": "ya29.token" },
			"now": 1000,
			"token": "ya29.token",
			"expires_at": 4600
		},
		{
			"name": "a lifetime below the minimum is raised to it",
			"block": "ibm",
			"status": 200,
			"json": { "access_token": "t", "expires_in": 5 },
			"now": 1000,
			"token": "t",
			"expires_at": 1060
		},
		{
			"name": "an HTTP refusal carries the service's message",
			"block": "ibm",
			"status": 400,
			"json": { "errorMessage": "Provided API key could not be found" },
			"now": 1000,
			"reason": "the token exchange answered HTTP 400: Provided API key could not be found"
		},
		{
			"name": "an OAuth refusal gives its description before its code",
			"block": "google",
			"status": 400,
			"json": { "error": "invalid_grant", "error_description": "Invalid JWT Signature." },
			"now": 1000,
			"reason": "the token exchange answered HTTP 400: Invalid JWT Signature."
		},
		{
			"name": "a Google error object gives its message, on one line",
			"block": "google",
			"status": 403,
			"json": {
				"error": {
					"code": 403,
					"message": "Permission denied\non resource",
					"status": "PERMISSION_DENIED"
				}
			},
			"now": 1000,
			"reason": "the token exchange answered HTTP 403: Permission denied on resource"
		},
		{
			"name": "a bare OAuth code is the message",
			"block": "google",
			"status": 400,
			"json": { "error": "invalid_grant" },
			"now": 1000,
			"reason": "the token exchange answered HTTP 400: invalid_grant"
		},
		{
			"name": "a refusal without JSON keeps its status alone",
			"block": "ibm",
			"status": 503,
			"now": 1000,
			"reason": "the token exchange answered HTTP 503"
		},
		{
			"name": "no token",
			"block": "ibm",
			"status": 200,
			"json": { "expires_in": 3600 },
			"now": 1000,
			"reason": "the token exchange answered no access_token"
		},
		{
			"name": "a token holding a space",
			"block": "ibm",
			"status": 200,
			"json": { "access_token": "a b" },
			"now": 1000,
			"reason": "the token exchange answered no access_token"
		}
	],
