{
	"description": "Golden vectors for the version and operating system the Debug > Report a bug issue form shows (healthcheck share document, fields.version and fields.os). A source run reports the version \"local\" and a commit tagged (git): the form says \"dev source <commit>\", never \"unknown\". The system is the name and version the driver reported, then (desktop, session, architecture) for what is known; a name outside the closed grammar of the platform_name rule (a path, an address) is dropped and the driver name stands in. Replayed by the macOS and Linux Lua suites and the AHK suite through the share document.",
	"vectors": [
		{
			"id": "macos_release",
			"snapshot": {
				"driver": "macos",
				"sections": {
					"versions": { "ergopti_version": "2.1.0", "commit": "abc1234 (build)" },
					"system": { "os": "macOS 15.1" },
					"hardware": { "arch": "arm64" }
				}
			},
			"version": "2.1.0",
			"os": "macOS 15.1 (arm64)"
		},
		{
			"id": "macos_source_run_names_its_commit",
			"snapshot": {
				"driver": "macos",
				"sections": {
					"versions": { "ergopti_version": "local", "commit": "9f02a05ef (git)" },
					"system": { "os": "macOS 15.1" },
					"hardware": { "arch": "arm64" }
				}
			},
			"version": "dev source 9f02a05ef",
			"os": "macOS 15.1 (arm64)"
		},
		{
			"id": "source_run_without_a_readable_commit",
			"snapshot": {
				"driver": "macos",
				"sections": {
					"versions": { "ergopti_version": "local", "commit": "unknown (unknown)" }
				}
			},
			"version": "dev source",
			"os": "macOS (version unknown)"
		},
		{
