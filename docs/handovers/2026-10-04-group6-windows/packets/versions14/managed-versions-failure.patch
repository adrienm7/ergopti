+test('generic integrity failure retains original translated reason and retry', () => {
+	const page = fixture(); page.sandbox.setInstallProgress({ tag: 'v1.2.3', phase: 'failed', reason_key: 'changelog_window.install_error_verify', backup_path: '/cfg/backup' });
+	assert.ok(page.el('install-text').textContent.includes(strings['changelog_window.install_error_verify'].split('{tag}').join('v1.2.3').split('{path}').join('/cfg/backup')));
