{
	"name": "svelte-static",
	"version": "3.0.0",
	"private": true,
	"scripts": {
		"predev": "node ./scripts/write-branch.js",
		"dev": "vite dev",
		"prebuild": "node ./scripts/write-branch.js",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"prepare": "husky install",
		"build:hotstrings": "node ./scripts/build-hotstrings.cjs",
		"build:manifest": "node ./scripts/build-features-manifest.js",
		"build:domain": "node ./scripts/build-domain.cjs",
		"lint:banners": "node ./scripts/audit-banner-alignment.js static/drivers/_shared",
		"lint:conventions": "node ./scripts/lint-conventions.js --warn-only",
		"lint:conventions:strict": "node ./scripts/lint-conventions.js --fail-on-violations",
		"test:port-compliance": "node ./scripts/test-port-compliance.cjs",
		"test:manifest-parity": "node ./scripts/test-manifest-parity.cjs",
		"test:ahk-encoding": "node ./scripts/test-ahk-encoding.cjs",
		"test:manifest-equivalence": "node ./scripts/test-manifest-equivalence.cjs",
		"test:properties": "node ./scripts/test-properties.cjs",
		"fix:banners": "node ./scripts/lint-conventions.js --fix-banners --warn-only",
		"fix:spacing": "node ./scripts/lint-conventions.js --fix-spacing --warn-only",
		"fix:unbalanced": "node ./scripts/lint-conventions.js --fix-unbalanced --warn-only",
		"fix:all": "node ./scripts/lint-conventions.js --fix-banners --fix-unbalanced --fix-spacing --warn-only",
		"install:hammerspoon": "bash ./scripts/install-hammerspoon.sh",
		"gen:diagram": "node ./scripts/gen-architecture-diagram.cjs",
		"new:driver": "node ./scripts/new-driver.js",
		"bench:hotstring": "node ./scripts/bench-hotstring.cjs",
		"codegen:registry": "node ./scripts/codegen-registry-ahk.cjs",
		"codegen:expander:ahk": "node ./scripts/codegen-expander-ahk.cjs",
		"codegen:registry:hs": "node ./scripts/codegen-registry-hs.cjs",
		"codegen:terminators": "node ./scripts/codegen-terminators.cjs",
		"codegen:expander:hs": "node ./scripts/codegen-expander-hs.cjs",
		"codegen:prompt-builder:ahk": "node ./scripts/codegen-prompt-builder-ahk.cjs",
		"codegen:shortcuts": "node ./scripts/codegen-shortcuts.cjs",
		"test:mutation": "stryker run"
	},
	"type": "module",
	"dependencies": {
		"aos": "^3.0.0-beta.6",
		"modern-normalize": "^3.0.1",
		"tocbot": "^4.30.0"
	},
	"devDependencies": {
		"@samkirkland/ftp-deploy": "^1.2.4",
		"@stryker-mutator/core": "^9.6.1",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/enhanced-img": "^0.8.1",
		"@sveltejs/kit": "^2.53.4",
		"@types/aos": "^3.0.7",
		"fast-check": "^4.8.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.1.5",
		"pm2": "^5.4.3",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-svelte": "^3.4.0",
		"smol-toml": "^1.3.0",
		"svelte": "^5.53.7",
		"vite": "^7.2.2"
	}
}
