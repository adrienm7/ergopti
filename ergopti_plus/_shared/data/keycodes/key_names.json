		"num_lock": { "i18n": "key_name.num_lock" },
		"volume_mute": { "i18n": "key_name.volume_mute" },
		"volume_down": { "i18n": "key_name.volume_down" },
		"volume_up": { "i18n": "key_name.volume_up" }
