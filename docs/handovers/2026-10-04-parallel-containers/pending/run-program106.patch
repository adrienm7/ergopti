+{
+	"contract": "versioned executable and literal argv; target availability is native and separate",
+	"cases": [
+		{
+			"id": "posix-empty",
+			"platforms": ["hs", "linux"],
+			"value": "{\"version\":1,\"executable\":\"/tmp/program\",\"arguments\":[]}",
+			"expected": {
+				"executable": "/tmp/program",
+				"arguments": []
+			}
+		},
+		{
+			"id": "literal-argv",
+			"platforms": ["hs", "linux"],
+			"value": "{\"version\":1,\"executable\":\"/tmp/été program\",\"arguments\":[\"\",\"two words\",\"日本語\",\"\\\"quoted\\\"\",\"\\\\tail\\\\\",\"$(touch ignored); %TOKEN%\",\"line\\nnext\"]}",
+			"expected": {
+				"executable": "/tmp/été program",
+				"arguments": [
+					"",
+					"two words",
+					"日本語",
+					"\"quoted\"",
+					"\\tail\\",
+					"$(touch ignored); %TOKEN%",
+					"line\nnext"
+				]
+			}
+		},
+		{
