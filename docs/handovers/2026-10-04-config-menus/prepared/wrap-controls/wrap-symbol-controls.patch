+		'an invisible/missing projected fragment cannot satisfy a composition edge'
+	);
+	assert.equal(
+		isComposedSeparatorFragment([{ type: 'label', i18n: 'unowned' }], new Set(['compose'])),
+		false,
+		'the exception is an actual separator shape, not arbitrary actionless data'
+	);
+	const edge = OPENS_SUBMENU.wrap_symbols_menu.find(
+		(entry) => entry.menu === 'wrap_symbols_custom_separator'
+	);
+	assert.equal(edge.kind, 'compose');
+	assert.deepEqual(edge.platforms, ['ahk', 'hs']);
+	for (const platform of edge.platforms) {
+		assert.equal(
+			isComposedSeparatorFragment(project(edge.menu, platform), new Set([edge.kind])),
+			true,
+			'actual declared separator fragment projects on each composing provider platform'
+		);
+		assert.equal(
+			isComposedSeparatorFragment(project(edge.menu, platform), new Set(['submenu'])),
+			false,
+			'wrong edge kind cannot turn its fragment into a clicked submenu'
+		);
+	}
+	assert.equal(
+		isComposedSeparatorFragment(project(edge.menu, 'linux'), new Set([edge.kind])),
+		false,
+		'a wrong Linux composition edge has no matching projected controls'
+	);
+}
