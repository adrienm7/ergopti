+				"-[ErgoptiPlusTests.KarabinerLeaseWorkerTests testCLIFileActionInitializationPreservesReturnedError]",
+				"-[ErgoptiPlusTests.KarabinerLeaseWorkerTests testCLILargeDiagnosticOutputCannotDeadlockBeforeExit]",
+				"-[ErgoptiPlusTests.KarabinerLeaseWorkerTests testCLIRequiresCompletelyEmptyDiagnosticsForSuccess]",
+				"-[ErgoptiPlusTests.KarabinerLeaseWorkerTests testDetachedWorkerStopsAfterBoundedDirectFenceSpawnFailures]",
+				"-[ErgoptiPlusTests.KarabinerLeaseWorkerTests testEOFAfterReadyFencesTheGeneration]",
