{
	"description": "Golden vectors for the diagnostics page's host actions: what a host accepts from the page and what it refuses, with the stable refusal code it logs. `schema` and `templates` are cut-down copies of _shared/modules/diagnostics/schema.json and issue_templates.json with a small max_export_bytes, so the byte bound is exercised by short texts; text lengths are counted in UTF-8 bytes. `expected` is the normalized action, `error` the refusal code. Replayed by _shared/lua/healthcheck/actions.lua in the macOS and Linux suites and by windows/ui/healthcheck/actions.ahk in the AHK suite.",
	"schema": {
		"max_export_bytes": 64,
		"report": {
			"subdir": "diagnostics",
			"name_prefix": "ergopti-diagnostics-",
			"name_suffix": ".md",
			"name_max_length": 60,
			"export_sequence_max": 9007199254740991
		},
		"permissions": {
			"macos": {
				"accessibility": {
					"settings": "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
				}
			},
			"windows": {},
			"linux": {
				"input_devices": {
					"fix": true
				}
			}
		},
		"sections": [
			{
				"id": "summary",
				"kind": "summary"
			},
			{
				"id": "paths",
				"fields": [
					{
						"id": "logs_dir",
						"type": "path"
					},
					{
						"id": "errors_today",
						"type": "path"
					},
					{
						"id": "launcher_log",
						"type": "path",
						"platforms": ["macos"]
					}
				]
			},
			{
				"id": "system",
				"fields": [
					{
						"id": "os",
						"type": "text"
					}
				]
			}
		]
	},
	"templates": {
		"templates": {
			"bug": {
				"file": "bug_report.yml",
				"title_prefix": "[Bug] ",
				"fields": ["version", "os", "driver", "diagnostics"],
				"report_field": "diagnostics"
			}
		}
	},
	"vectors": [
		{
			"id": "copy_ok",
			"driver": "macos",
			"message": {
				"action": "copy",
				"text": "hello"
			},
			"expected": {
				"action": "copy",
				"text": "hello"
			}
		},
		{
			"id": "copy_empty_text",
			"driver": "linux",
			"message": {
				"action": "copy",
				"text": ""
			},
			"error": "bad_text"
		},
		{
			"id": "copy_text_not_a_string",
			"driver": "windows",
			"message": {
				"action": "copy",
				"text": 42
			},
			"error": "bad_text"
		},
		{
			"id": "copy_text_at_the_bound",
			"driver": "windows",
			"message": {
				"action": "copy",
				"text": "0123456789012345678901234567890123456789012345678901234567890123"
			},
			"expected": {
				"action": "copy",
				"text": "0123456789012345678901234567890123456789012345678901234567890123"
			}
		},
		{
			"id": "copy_text_over_the_bound",
			"driver": "windows",
			"message": {
				"action": "copy",
				"text": "01234567890123456789012345678901234567890123456789012345678901234"
			},
			"error": "bad_text"
		},
		{
			"id": "copy_bound_counts_utf8_bytes",
			"driver": "macos",
			"message": {
				"action": "copy",
				"text": "éééééééééééééééééééééééééééééééééé"
			},
			"error": "bad_text"
		},
		{
			"id": "copy_multibyte_within_bound",
			"driver": "macos",
			"message": {
				"action": "copy",
				"text": "éééééééééééééééééééééééééééééééé"
			},
			"expected": {
				"action": "copy",
				"text": "éééééééééééééééééééééééééééééééé"
			}
		},
