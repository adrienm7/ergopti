# ===============================================
# ===============================================
# ======= 3/ Auto-generated runtime files =======
# ===============================================
# ===============================================

# Runtime-only files dropped into _generated/ — not built from source
static/ergopti_plus/windows/_generated/paths.toml
static/ergopti_plus/macos/_generated/paths.toml
# Bootstrap config auto-generated at runtime — gitignored at driver root too
static/ergopti_plus/macos/paths.toml
static/ergopti_plus/windows/paths.toml
# Artefact Windows (résidu de redirection shell)
static/ergopti_plus/macos/nul
static/ergopti_plus/windows/_generated/personal_shortcuts.ahk
static/ergopti_plus/windows/_generated/prefetch_*.json
static/ergopti_plus/shared/ui/metrics_typing/prefetch.json
static/ergopti_plus/shared/ui/metrics_apps/prefetch.json

# Self-healing locale fast-parse cache. The .json beside each is the single
# tracked source of truth; the Windows driver writes/refreshes the .tsv on demand
# (lib/i18n.ahk _I18nWriteTsvCache) for ~23x faster boot parsing. Never tracked —
# it is regenerated from the .json whenever missing or older than its source.
static/ergopti_plus/shared/locales/*.tsv

# Self-healing hotstrings cache. The category .toml files beside it are the single
# tracked source of truth; the Windows driver builds/refreshes the .tsv on demand
# (lib/hotstrings/hotstrings_cache.ahk) so the bundled hotstrings no longer ship as
# committed generated AHK. Never tracked — rebuilt whenever missing or older than
# any source TOML. The old generated_*.ahk bundle is ignored too, for safety.
static/ergopti_plus/shared/hotstrings/generated_hotstrings.tsv
static/ergopti_plus/windows/lib/hotstrings/generated_*.ahk
static/ergopti_plus/windows/lib/hotstrings/hotstrings_generated.ahk

# Corpus working copy produced by build scripts
static/corpus/modifie/

# Test files
test_results.txt

# Scratch / debug artifacts — never part of the source tree (see also /log.txt).
# These accumulate from ad-hoc debugging of the AHK driver and the test runner.
test_out.txt
test_output.txt
run_all_out.txt
e2e_output.txt
out.txt
err.txt
static/ergopti_plus/windows/debug*.ahk
static/ergopti_plus/windows/debug*.txt
static/ergopti_plus/windows/tests/debug*.txt
static/ergopti_plus/scratch/

# Stryker mutation testing temporary directory
.stryker-tmp/







