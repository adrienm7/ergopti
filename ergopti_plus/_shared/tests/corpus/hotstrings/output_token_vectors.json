		{
			"id": "tab",
			"output": "a{Tab}b",
			"tokens": [{ "text": "a" }, { "key": "tab", "count": 1 }, { "text": "b" }],
			"text": "ab",
			"has_keys": true
		},
		{
			"id": "backspace",
			"output": "{BackSpace}",
			"tokens": [{ "key": "backspace", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "bs-is-backspace",
