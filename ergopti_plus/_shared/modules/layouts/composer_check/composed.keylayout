	<actions>
		<action id="azerty__dead_circumflex">
			<when state="none" next="azerty__circumflex"/>
		</action>
		<action id="azerty__dead_diaeresis">
			<when state="none" next="azerty__diaeresis"/>
		</action>
		<action id="c_0020">
			<when state="none" output=" "/>
			<when state="azerty__circumflex" output="^"/>
			<when state="azerty__diaeresis" output="¨"/>
		</action>
		<action id="c_0041">
			<when state="none" output="A"/>
			<when state="azerty__circumflex" output="Â"/>
			<when state="azerty__diaeresis" output="Ä"/>
		</action>
		<action id="c_0045">
			<when state="none" output="E"/>
			<when state="azerty__circumflex" output="Ê"/>
			<when state="azerty__diaeresis" output="Ë"/>
		</action>
		<action id="c_0049">
			<when state="none" output="I"/>
			<when state="azerty__circumflex" output="Î"/>
			<when state="azerty__diaeresis" output="Ï"/>
		</action>
		<action id="c_004f">
			<when state="none" output="O"/>
			<when state="azerty__circumflex" output="Ô"/>
			<when state="azerty__diaeresis" output="Ö"/>
		</action>
		<action id="c_0055">
			<when state="none" output="U"/>
			<when state="azerty__circumflex" output="Û"/>
			<when state="azerty__diaeresis" output="Ü"/>
		</action>
		<action id="c_0061">
			<when state="none" output="a"/>
			<when state="azerty__circumflex" output="â"/>
			<when state="azerty__diaeresis" output="ä"/>
		</action>
		<action id="c_0065">
			<when state="none" output="e"/>
			<when state="azerty__circumflex" output="ê"/>
			<when state="azerty__diaeresis" output="ë"/>
		</action>
		<action id="c_0069">
			<when state="none" output="i"/>
			<when state="azerty__circumflex" output="î"/>
			<when state="azerty__diaeresis" output="ï"/>
		</action>
		<action id="c_006f">
			<when state="none" output="o"/>
			<when state="azerty__circumflex" output="ô"/>
			<when state="azerty__diaeresis" output="ö"/>
		</action>
		<action id="c_0075">
			<when state="none" output="u"/>
