					"replacement": "facebook",
					"auto": false,
					"word_start": true
				},
				{
					"trigger": "facebook",
					"replacement": "Facebook",
					"auto": false,
					"word_start": true,
					"case_sensitive": true
				}
			],
			"max_arrows": 1,
			"typed": "fb",
			"end_char": " ",
