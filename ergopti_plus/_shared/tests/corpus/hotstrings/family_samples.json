{
	"$schema": "https://ergopti.com/schema/corpus/hotstring_family_samples.v1.json",
	"description": "Two or three SHIPPED expansions per hotstring family of the menu manifest (hotstring_category_keys in _shared/modules/menu/menu_manifest.json). vectors.json pins the engine on hand-written entries; this file pins the shipped data. Each sample names the shipped file (relative to static/), its section and the trigger; the replay reads that entry through the shared parser _shared/lua/toml_codec/reader.lua, with its own output and flags, then types `buffer` and, for an entry that waits for one, `terminator`, through the E2E harness of each Lua driver, exactly as it replays vectors.json. `expected` has the meaning it has in vectors.json (backspace_count is the logical count of replaced codepoints). A family listed in `excluded_families` ships no file to sample, for the reason given.",
	"version": "1.0.0",
	"field_semantics": {
		"family": "A key of hotstring_category_keys in the menu manifest. Every family not excluded must have at least two samples.",
		"file": "The shipped hotstring file, relative to the repository's static/ directory.",
		"section": "The [[section]] of that file the entry is declared in.",
		"trigger": "The entry's trigger exactly as the file spells it."
	},
	"excluded_families": {
		"dynamic_hotstrings": "Dates and personal-information prefixes are computed at expansion time (_shared/lua/dynamic_hotstrings); their replay lives in the dynamic_hotstrings corpus."
	},
	"samples": [
		{
			"id": "autocorrection.abbreviations.adn",
			"family": "autocorrection",
			"file": "ergopti_plus/_shared/modules/hotstrings/autocorrection.toml",
			"section": "abbreviations",
			"trigger": "adn",
			"buffer": "adn",
			"terminator": " ",
			"expected": {
				"matched": true,
				"replacement": "ADN",
				"backspace_count": 3
			}
		},
		{
			"id": "autocorrection.names.autohotkey",
			"family": "autocorrection",
			"file": "ergopti_plus/_shared/modules/hotstrings/autocorrection.toml",
