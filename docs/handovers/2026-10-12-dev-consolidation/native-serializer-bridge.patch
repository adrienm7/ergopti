+/** Serialization cannot observe raw release as a new attempt or write outputs. */
+typedef struct NavOutputSerializeReleaseProbe {
+	ErgoptiOutput_Key key;
+	uint64_t attempt;
+	uint32_t observations;
+	bool preserved;
