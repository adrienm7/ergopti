diff --git a/static/ergopti_plus/windows/tests/support/tooltip_segment_probe.ahk b/static/ergopti_plus/windows/tests/support/tooltip_segment_probe.ahk
new file mode 100644
--- /dev/null
+++ b/static/ergopti_plus/windows/tests/support/tooltip_segment_probe.ahk
@@ -0,0 +1,43 @@
+﻿; Temporary QPC segment probe; no telemetry I/O inside the measured loop.
+#Requires AutoHotkey v2.0
+
+global _TBP_TraceEnabled := false
+global _TBP_TraceBuffer := Buffer(100 * 11 * 8, 0)
+global _TBP_TraceOffset := 0
+
+_TBP_TraceMark(Slot) {
+	global _TBP_TraceEnabled, _TBP_TraceBuffer, _TBP_TraceOffset
+	if !IsSet(_TBP_TraceEnabled) || !_TBP_TraceEnabled
+		return
+	Tick := 0
+	DllCall("Kernel32\QueryPerformanceCounter", "Int64*", &Tick)
+	NumPut("Int64", Tick, _TBP_TraceBuffer, _TBP_TraceOffset + Slot * 8)
+}
+
+_TBP_ThreadCpuMs() {
+	static Created := Buffer(8), Exited := Buffer(8), Kernel := Buffer(8), User := Buffer(8)
+	if !DllCall("Kernel32\GetThreadTimes", "Ptr", -2, "Ptr", Created, "Ptr", Exited,
+		"Ptr", Kernel, "Ptr", User, "Int")
+		throw OSError()
+	return (NumGet(Kernel, 0, "Int64") + NumGet(User, 0, "Int64")) / 10000
+}
+
+_TBP_TraceDump(Frequency, CpuMs, WallMs) {
+	global _TBP_TraceBuffer
+	Text := "# PROFILE cpu_ms=" . CpuMs . " wall_ms=" . WallMs . "`n"
+	Text .= "# sample,total,prelude,pool,validation,move,build_finally,assert_hwnd,recycle_prelude,hide,recycle_finally,assert_recycled`n"
+	Loop 100 {
+		Offset := (A_Index - 1) * 11 * 8
+		First := NumGet(_TBP_TraceBuffer, Offset, "Int64")
+		Last := NumGet(_TBP_TraceBuffer, Offset + 10 * 8, "Int64")
+		Text .= "# SAMPLE," . A_Index . "," . (Last - First) * 1000 / Frequency
+		Previous := First
+		Loop 10 {
+			Tick := NumGet(_TBP_TraceBuffer, Offset + A_Index * 8, "Int64")
+			Text .= "," . (Tick - Previous) * 1000 / Frequency
+			Previous := Tick
+		}
+		Text .= "`n"
+	}
+	FileAppend(Text, "*")
+}
