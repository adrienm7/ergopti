+
+-- ==================================================
+-- ==================================================
+-- ======= 4/ Cursor Display Window Operation =======
+-- ==================================================
+-- ==================================================
+
+--- Independent native query packet: the active window is on the left display,
+--- the cursor on the right, and the topmost other window on the left.
+local CURSOR111_PACKET = [[pointer
+X=1500
+Y=200
+SCREEN=0
+WINDOW=101
+monitors
+Monitors: 2
+ 0: +*LEFT 1000/300x800/240+0+0 LEFT
+ 1: +RIGHT 1000/300x800/240+1000+0 RIGHT
+active
+101
+desktop
+0
+stacking
+0x65, 0x66, 0x67
+window 0x65
+WINDOW=101
+X=100
+Y=100
+WIDTH=500
+HEIGHT=400
+SCREEN=0
+DESKTOP=0
+ELIGIBLE=1
+end_window
+window 0x66
+WINDOW=102
+X=1100
+Y=100
+WIDTH=500
+HEIGHT=400
+SCREEN=0
+DESKTOP=0
+ELIGIBLE=1
+end_window
+window 0x67
+WINDOW=103
+X=100
+Y=100
+WIDTH=500
+HEIGHT=400
+SCREEN=0
+DESKTOP=0
+ELIGIBLE=1
+end_window
+end_snapshot
+]]
+
+--- Runs actual native parsing, adapter and action code behind recording ports.
+--- @param options table Query/activation refusal or independent changed packet.
+--- @param body function Receives actual adapter, real gesture manager and observations.
+local function cursor111_ports(options, body)
+	local names = { "adapters.shell_runner", "infra.display_server", "adapters.window_switch",
+		"modules.gestures.system_actions", "modules.gestures.manager", "adapters.notifier",
+		"modules.gestures.combo_emitter", "adapters.clipboard", "adapters.event_loop" }
+	local saved = {}
+	for _, name in ipairs(names) do saved[name] = package.loaded[name] end
+	local execute = os.execute
+	local seen = { queries = 0, activations = {}, combos = {}, commands = {}, notices = {} }
+	local Shell = helpers.load_module("adapters.shell_runner")
+	Shell._set_runner(function(command)
+		seen.commands[#seen.commands + 1] = command
+		if command:find("command -v", 1, true) then
+			return options.missing_tool ~= command:match("command %-v '([^']+)'")
+		end
+		if command:find("sh -c", 1, true) then
+			seen.queries = seen.queries + 1
+			if options.query_throw then error("closed native query refusal") end
+			local packet = seen.queries == 1 and (options.first or CURSOR111_PACKET)
+				or (options.second or options.first or CURSOR111_PACKET)
+			return { ok = options.query_ack ~= false, output = packet }
+		end
+		if command:find("xdotool windowactivate", 1, true) then
+			seen.activations[#seen.activations + 1] = command
+			if options.activation_throw then error("closed native activation refusal") end
+			return options.activation_ack == nil and true or options.activation_ack
+		end
+		return false
+	end)
+	if options.raw_activation_set then
+		Shell.run = function(command)
+			if command:find("command -v", 1, true) then return true end
+			seen.activations[#seen.activations + 1] = command
+			return options.activation_ack
+		end
+	end
+	local Display = helpers.load_module("infra.display_server")
+	Display._set_for_test(options.display or Display.X11, "fixture")
+	package.loaded["modules.gestures.combo_emitter"] = { press = function(combo)
+		seen.combos[#seen.combos + 1] = combo
+		return true
+	end }
+	package.loaded["adapters.clipboard"] = {}
+	package.loaded["adapters.event_loop"] = { sleep_ms = function() end }
+	package.loaded["adapters.notifier"] = { send = function(message)
+		seen.notices[#seen.notices + 1] = message
+		return true
+	end }
+	os.execute = function(command)
+		seen.commands[#seen.commands + 1] = command
+		return true
+	end
+	local Switch = helpers.load_module("adapters.window_switch")
+	helpers.load_module("modules.gestures.system_actions")
+	local Gestures = helpers.load_module("modules.gestures.manager")
+	local ok, err = pcall(body, Switch, Gestures, seen)
+	os.execute = execute
+	Shell._reset_runner()
+	for _, name in ipairs(names) do package.loaded[name] = saved[name] end
+	if not ok then error(err, 0) end
+end
+
+helpers.describe("Cursor-display window operation (TODO111)", function()
+	helpers.it("the actual action focuses the cursor display, not the active window display", function()
+		cursor111_ports({}, function(_, Gestures, seen)
+			Gestures.execute_action("alt_tab_monitor", "tap_3")
+			helpers.assert_eq(seen.queries, 2)
+			helpers.assert_eq(seen.activations, { "timeout 1 xdotool windowactivate '102' >/dev/null 2>&1" })
+			helpers.assert_eq(seen.combos, {}, "the scoped action must not emit global Alt+Tab")
+		end)
+	end)
+
+	helpers.it("normal system Alt+Tab remains a separate actual action", function()
+		cursor111_ports({}, function(_, Gestures, seen)
+			Gestures.execute_action("app_switcher", "tap_3")
+			helpers.assert_eq(seen.combos, { "alt+Tab" })
+			helpers.assert_eq(seen.queries, 0)
+			helpers.assert_eq(seen.activations, {})
+		end)
+	end)
+
+	helpers.it("both existing action identities remain visible, with a truthful X11 requirement", function()
+		local Catalogue = require("_generated.action_catalogue")
+		helpers.assert_true(Catalogue.actions.app_switcher ~= nil)
+		helpers.assert_true(Catalogue.actions.alt_tab_monitor ~= nil)
+		helpers.assert_eq(Catalogue.actions.alt_tab_monitor.requires,
+			{ "session:x11", "tool:timeout", "tool:xdotool", "tool:xrandr", "tool:xprop" })
+		helpers.assert_eq(require("_generated.gesture_emit_actions").alt_tab_monitor, nil)
+		helpers.assert_eq(require("_generated.gesture_emit_actions").app_switcher, "alt+Tab")
+	end)
+
+	helpers.it("Wayland refuses execution and offers the existing translated X11 reason", function()
+		cursor111_ports({ display = "wayland" }, function(Switch, Gestures, seen)
+			local accepted, reason = Switch.previous_on_cursor_display()
+			helpers.assert_eq(false, accepted)
+			helpers.assert_eq(reason, "dialog.action_picker.requires_x11")
+			Gestures.execute_action("alt_tab_monitor", "tap_3")
+			helpers.assert_eq(seen.queries, 0)
+			helpers.assert_eq(seen.activations, {})
+			helpers.assert_eq(seen.combos, {})
+			helpers.assert_eq(#seen.notices, 1)
+		end)
+	end)
+
+	for _, tool in ipairs({ "timeout", "xdotool", "xrandr", "xprop" }) do
+		helpers.it("missing " .. tool .. " refuses before querying or activating", function()
+			cursor111_ports({ missing_tool = tool }, function(Switch, _, seen)
+				local accepted, reason, missing = Switch.previous_on_cursor_display()
+				helpers.assert_eq(false, accepted)
+				helpers.assert_eq(reason, "dialog.action_picker.requires_tool")
+				helpers.assert_eq(missing, tool)
+				helpers.assert_eq(seen.queries, 0)
+				helpers.assert_eq(seen.activations, {})
+			end)
+		end)
+	end
+
+	for _, change in ipairs({
+		{ name = "cursor moved to the active window display", packet = CURSOR111_PACKET:gsub("X=1500", "X=200", 1) },
+		{ name = "cursor outside every display", packet = CURSOR111_PACKET:gsub("X=1500", "X=2500", 1) },
+		{ name = "active window changed", packet = CURSOR111_PACKET:gsub("active\n101", "active\n103", 1) },
+		{ name = "target geometry changed", packet = CURSOR111_PACKET:gsub("X=1100", "X=100", 1) },
+		{ name = "target minimized or ineligible", packet = CURSOR111_PACKET:gsub("DESKTOP=0\nELIGIBLE=1\nend_window\nwindow 0x67", "DESKTOP=0\nELIGIBLE=0\nend_window\nwindow 0x67", 1) },
+		{ name = "desktop changed", packet = CURSOR111_PACKET:gsub("desktop\n0", "desktop\n1", 1) },
+	}) do
+		helpers.it("revalidation refuses when " .. change.name, function()
+			cursor111_ports({ second = change.packet }, function(Switch, _, seen)
+				helpers.assert_eq(false, Switch.previous_on_cursor_display())
+				helpers.assert_eq(seen.activations, {})
+			end)
+		end)
+	end
+
+	for _, malformed in ipairs({
+		CURSOR111_PACKET:sub(1, -2),
+		CURSOR111_PACKET:gsub("X=1500", "UNKNOWN=1\nX=1500", 1),
+		CURSOR111_PACKET:gsub("WIDTH=500", "UNKNOWN=1\nWIDTH=500", 1),
+		CURSOR111_PACKET:gsub("Monitors: 2", "Monitors: 999999999999999999999999", 1),
+		CURSOR111_PACKET:gsub("1000/300x800", "999999999999999999999999/300x800", 1),
+		CURSOR111_PACKET:gsub("0x65, 0x66, 0x67", "0x65, , 0x66, 0x67", 1),
+		CURSOR111_PACKET .. "unexpected\n",
+		CURSOR111_PACKET:gsub("WIDTH=500", "WIDTH=0", 1),
+		CURSOR111_PACKET:gsub("0x65, 0x66, 0x67", "0x65, 0x66, 0x66", 1),
+		CURSOR111_PACKET:gsub("1000/300x800/240%+1000%+0", "1000/300x800/240+0+0", 1),
+	}) do
+		helpers.it("a malformed or ambiguous native packet never activates", function()
+			cursor111_ports({ first = malformed }, function(Switch, _, seen)
+				helpers.assert_eq(false, Switch.previous_on_cursor_display())
+				helpers.assert_eq(seen.activations, {})
+			end)
+		end)
+	end
+
+	helpers.it("a spanning window belongs to its centre display, not its top-left corner", function()
+		local packet = CURSOR111_PACKET:gsub("X=1100", "X=800", 1)
+		cursor111_ports({ first = packet }, function(Switch, _, seen)
+			helpers.assert_true(Switch.previous_on_cursor_display())
+			helpers.assert_eq(#seen.activations, 1)
+		end)
+	end)
+
+	for _, ack in ipairs({ false, 0, 1, "ack" }) do
+		helpers.it("the activation adapter refuses a non-true receipt", function()
+			cursor111_ports({ activation_ack = ack, raw_activation_set = true }, function(Switch, _, seen)
+				helpers.assert_eq(false, Switch.previous_on_cursor_display())
+				helpers.assert_eq(#seen.activations, 1)
+			end)
+		end)
+	end
+
+	helpers.it("a native query refusal does not try global switching", function()
+		cursor111_ports({ query_ack = false }, function(Switch, Gestures, seen)
+			helpers.assert_eq(false, Switch.previous_on_cursor_display())
+			Gestures.execute_action("alt_tab_monitor", "tap_3")
+			helpers.assert_eq(seen.activations, {})
+			helpers.assert_eq(seen.combos, {})
+		end)
+	end)
+
+	helpers.it("a missing activation receipt is a refusal", function()
+		cursor111_ports({ raw_activation_set = true }, function(Switch, _, seen)
+			helpers.assert_eq(false, Switch.previous_on_cursor_display())
+			helpers.assert_eq(#seen.activations, 1)
+		end)
+	end)
+
+	for _, failure in ipairs({ "query_throw", "activation_throw" }) do
+		helpers.it("the actual action contains a native " .. failure .. " without global fallback", function()
+			cursor111_ports({ [failure] = true }, function(_, Gestures, seen)
+				Gestures.execute_action("alt_tab_monitor", "tap_3")
+				helpers.assert_eq(seen.combos, {})
+				helpers.assert_eq(#seen.activations, failure == "query_throw" and 0 or 1)
+			end)
+		end)
+	end
+
+	for _, packet in ipairs({
+		CURSOR111_PACKET:gsub("window 0x66\n.-end_window", "window 0x66\nUNAVAILABLE=1\nend_window", 1),
+		CURSOR111_PACKET:gsub("DESKTOP=0\nELIGIBLE=1\nend_window\nwindow 0x67", "DESKTOP=0\nELIGIBLE=0\nend_window\nwindow 0x67", 1),
+		CURSOR111_PACKET:gsub("X=1100", "X=100", 1),
+	}) do
+		helpers.it("an initially closed, minimized or foreign-display target never activates", function()
+			cursor111_ports({ first = packet }, function(Switch, _, seen)
+				helpers.assert_eq(false, Switch.previous_on_cursor_display())
+				helpers.assert_eq(seen.activations, {})
+			end)
+		end)
+	end
+
+	helpers.it("a fresh retry after refused activation uses new snapshots", function()
+		cursor111_ports({ activation_ack = false }, function(Switch, _, seen)
+			helpers.assert_eq(false, Switch.previous_on_cursor_display())
+			helpers.assert_eq(seen.queries, 2)
+		end)
+		cursor111_ports({}, function(Switch, _, seen)
+			helpers.assert_true(Switch.previous_on_cursor_display())
+			helpers.assert_eq(seen.queries, 2)
+			helpers.assert_eq(#seen.activations, 1)
+		end)
+	end)
+end)
