+static int OutputRangesOverlap(const void *a, size_t an, const void *b, size_t bn)
+{
+	uintptr_t ap = (uintptr_t)a, bp = (uintptr_t)b;
+	if (an > UINTPTR_MAX - ap || bn > UINTPTR_MAX - bp) return 1;
+	return ap < bp + bn && bp < ap + an;
