			"unavailable": "hide"
		},
		{
			"type": "command",
			"id": "llm_profile_edit",
			"i18n": "menu.profiles.edit_profile",
			"disabled_when": ["llm_custom_profile_ready"],
			"platforms": ["hs", "linux"],
			"unavailable": "hide"
		},
