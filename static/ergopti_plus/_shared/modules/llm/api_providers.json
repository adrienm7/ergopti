{
	"_comment": "Single source of truth for remote LLM API providers and per-model pricing. Both drivers (AHK api_remote.ahk and HS api_remote.lua) load this file at boot — add a provider here first, then reload the driver. `format` is openai, anthropic, gemini, backboard (Backboard's assistant/thread API, key in X-API-Key, models written <llm_provider>/<model_name>) or decisions (TypeSafe's System One protocol: typed questions in, answers with probabilities out; base_url is the full endpoint and the key goes in Authorization: Bearer). A decisions provider serves Jev, which is not a chat model: it is offered only as the agent's System 1. The request shapes of backboard and decisions live in _shared/lua/llm/remote_formats.lua. `thinking_off` (optional) turns reasoning off, or to the lowest level a model accepts, in every request to that provider: an ordered list of { models: [glob], fields: {...} }. A glob matches the whole model id, ignoring case, with * as its only wildcard; the first matching rule wins and no match adds nothing (an unknown field is an HTTP 400, so an undocumented model is sent as it is; empty fields shield a model from a broader glob below). The fields are deep-merged into the body of every format, and a field the body already sets wins at every level. Each rule cites its official source in _source (checked 2026-10-30). Resolved by _shared/lua/llm/thinking_off.lua and _shared/modules/llm/thinking_off.ahk, pinned by _shared/tests/corpus/llm/thinking_off_vectors.json.",
	"provider_order": [
		"openai",
		"anthropic",
		"gemini",
		"xai",
		"mistral",
		"deepseek",
		"cohere",
		"cerebras",
		"openrouter",
		"groq",
		"together",
		"fireworks",
		"backboard",
		"typesafe",
		"openrouter_jev",
		"openai_compat"
	],
	"providers": {
		"openai": {
			"label": "OpenAI",
			"base_url": "https://api.openai.com/v1",
			"default_model": "gpt-4o-mini",
			"format": "openai",
			"thinking_off": [
				{
					"models": ["gpt-6*"],
					"fields": { "reasoning_effort": "low" },
					"_source": "https://developers.openai.com/api/docs/guides/reasoning (GPT-6 Astra and GPT-6.1 Sol refuse none; 6.1 Sol refuses minimal)"
				},
				{
					"models": ["gpt-5-pro*", "gpt-5*-pro*", "gpt-5*-codex*", "gpt-5*-chat*"],
					"fields": {},
					"_source": "https://developers.openai.com/api/docs/models (pro and codex models are not served on chat completions; chat-latest documents no reasoning_effort)"
				},
				{
					"models": ["gpt-5.*"],
					"fields": { "reasoning_effort": "none" },
					"_source": "https://developers.openai.com/api/docs/models/gpt-5.1 (none, low, medium, high)"
				},
				{
					"models": ["gpt-5", "gpt-5-2025-*"],
					"fields": { "reasoning_effort": "minimal" },
					"_source": "https://developers.openai.com/api/docs/models/gpt-5 (minimal, low, medium, high)"
				},
				{
					"models": ["o1", "o1-2*", "o3", "o3-2*", "o4-mini*"],
					"fields": { "reasoning_effort": "low" },
					"_source": "https://developers.openai.com/api/docs/guides/reasoning (o-series: low, medium, high)"
				}
			]
		},
		"anthropic": {
			"label": "Anthropic",
			"base_url": "https://api.anthropic.com/v1",
			"default_model": "claude-haiku-4-5",
			"format": "anthropic",
			"thinking_off": [
				{
					"models": [
						"claude-opus-5-5*",
						"claude-fable-5*",
						"claude-mythos-5*",
						"claude-mythos-preview*"
					],
					"fields": { "output_config": { "effort": "low" } },
					"_source": "https://platform.claude.com/docs/en/build-with-claude/thinking (they reject thinking disabled; low is the lowest effort: https://platform.claude.com/docs/en/build-with-claude/effort)"
				},
				{
					"models": ["claude-sonnet-5-5*"],
					"fields": { "thinking": { "type": "between_tools" } },
					"_source": "https://platform.claude.com/docs/en/build-with-claude/thinking (lowest thinking setting; disabled is refused)"
				},
				{
					"models": ["claude-opus-5*", "claude-haiku-5-5*", "claude-sonnet-5*"],
					"fields": { "thinking": { "type": "disabled" } },
					"_source": "https://platform.claude.com/docs/en/build-with-claude/thinking (Claude 4.x and older think only when asked)"
				}
			]
		},
		"gemini": {
			"label": "Google Gemini",
			"base_url": "https://generativelanguage.googleapis.com/v1beta",
			"default_model": "gemini-2.0-flash",
			"format": "gemini",
			"thinking_off": [
				{
					"models": ["gemini-2.5-flash-image*", "gemini-2.5-flash*tts*", "gemini-2.5-flash*audio*"],
					"fields": {},
					"_source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking (documents no thinking for the image, speech and audio models)"
				},
				{
					"models": ["gemini-2.5-flash*"],
					"fields": { "generationConfig": { "thinkingConfig": { "thinkingBudget": 0 } } },
					"_source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking (Flash and Flash-Lite: disable with thinkingBudget = 0)"
				},
				{
					"models": ["gemini-2.5-pro*"],
					"fields": { "generationConfig": { "thinkingConfig": { "thinkingBudget": 128 } } },
					"_source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking (Pro: 128 to 32768, cannot disable thinking)"
				},
				{
					"models": [
						"gemini-3.1-flash-lite-image*",
						"gemini-3-flash*",
						"gemini-3.1-flash-lite*",
						"gemini-3.5-flash-lite*",
						"gemini-3.6-flash*"
					],
					"fields": { "generationConfig": { "thinkingConfig": { "thinkingLevel": "minimal" } } },
					"_source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking (these accept minimal)"
				},
				{
					"models": ["gemini-3*", "gemini-4*"],
					"fields": { "generationConfig": { "thinkingConfig": { "thinkingLevel": "low" } } },
					"_source": "https://ai.google.dev/gemini-api/docs/generate-content/thinking (gemini-3.8-flash refuses minimal; Pro and gemini-4 start at low)"
				}
			]
		},
		"xai": {
			"label": "xAI (Grok)",
			"base_url": "https://api.x.ai/v1",
			"default_model": "grok-2-mini",
			"format": "openai",
			"thinking_off": [
				{
					"models": ["grok-4.3*"],
					"fields": { "reasoning_effort": "none" },
