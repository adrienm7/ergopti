diff --git a/static/ergopti_plus/windows/tests/support/tooltip_thread_probe.ahk b/static/ergopti_plus/windows/tests/support/tooltip_thread_probe.ahk
new file mode 100644
--- /dev/null
+++ b/static/ergopti_plus/windows/tests/support/tooltip_thread_probe.ahk
@@ -0,0 +1,49 @@
+﻿#Requires AutoHotkey v2.0
+
+global _TPT_Enabled := EnvGet("ERGOPTI_TOOLTIP_THREAD_PROFILE") = "1"
+global _TPT_Thread := DllCall("Kernel32\GetCurrentThread", "Ptr")
+global _TPT_Times := Buffer(32, 0)
+global _TPT_Rows := Buffer(100 * 5 * 32, 0)
+
+_TPT_Capture(Slot) {
+	global _TPT_Enabled, _TPT_Thread, _TPT_Times, _TPT_Rows
+	if !_TPT_Enabled
+		return _TBP_Qpc()
+	if !DllCall("Kernel32\GetThreadTimes", "Ptr", _TPT_Thread,
+		"Ptr", _TPT_Times.Ptr, "Ptr", _TPT_Times.Ptr + 8,
+		"Ptr", _TPT_Times.Ptr + 16, "Ptr", _TPT_Times.Ptr + 24, "Int")
+		throw OSError(A_LastError, "GetThreadTimes")
+	Cycles := 0
+	if !DllCall("Kernel32\QueryThreadCycleTime", "Ptr", _TPT_Thread, "UInt64*", &Cycles, "Int")
+		throw OSError(A_LastError, "QueryThreadCycleTime")
+	Counter := _TBP_Qpc()
+	NumPut("Int64", Counter, "Int64", Cycles,
+		"Int64", NumGet(_TPT_Times, 16, "Int64"),
+		"Int64", NumGet(_TPT_Times, 24, "Int64"), _TPT_Rows, Slot * 32)
+	return Counter
+}
+
+_TPT_Delta(SampleIndex, StartBoundary, EndBoundary, FieldOffset) {
+	global _TPT_Rows
+	BaseOffset := (SampleIndex - 1) * 160 + FieldOffset
+	return NumGet(_TPT_Rows, BaseOffset + EndBoundary * 32, "Int64")
+		- NumGet(_TPT_Rows, BaseOffset + StartBoundary * 32, "Int64")
+}
+
+_TPT_Emit(Samples, Clamps, Shows, Corners, Borders) {
+	global _TPT_Enabled
+	FileAppend("# THREAD_PROFILE_META,pid=" . ProcessExist()
+		. ",tid=" . DllCall("Kernel32\GetCurrentThreadId", "UInt")
+		. ",enabled=" . _TPT_Enabled . "`n", "*")
+	for SampleIndex, Total in Samples {
+		Line := Format("# THREAD_PROFILE,{1},{2},{3:.6f},{4:.6f},{5:.6f},{6:.6f},{7:.6f}",
+			_TPT_Enabled, SampleIndex, Total, Clamps[SampleIndex], Shows[SampleIndex],
+			Corners[SampleIndex], Borders[SampleIndex])
+		for Bounds in [[0, 4], [1, 2]] {
+			Line .= "," . _TPT_Delta(SampleIndex, Bounds[1], Bounds[2], 8)
+				. "," . (_TPT_Delta(SampleIndex, Bounds[1], Bounds[2], 16) / 10000)
+				. "," . (_TPT_Delta(SampleIndex, Bounds[1], Bounds[2], 24) / 10000)
+		}
+		FileAppend(Line . "`n", "*")
+	}
+}
