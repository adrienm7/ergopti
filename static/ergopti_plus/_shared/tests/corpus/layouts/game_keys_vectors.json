{
	"_comment": "« Touches de jeu » (layout.game_keys, layout.game_keys_apps), replayed by macOS and Linux (_shared/layouts/engine/emulation/game_keys.lua) and Windows (windows/modules/keymap/keylayout/game_keys.ahk) so the three drivers resolve the same choice, take the same route and send the same keys held. resolve: the [layout] table of config.toml and the settings it reads (an outdated value reads as the default). choice_for: the choice in force for an application and whether it is its own. apps_with: the application table once an application's choice is set (null follows the global choice again). routes: per OS, Ergopti mode (emulation, installed, system), choice and capabilities (installed_layout: a listed system layout types what the emulation types; game: the application has its own choice), the strategy and the identity a game reads, and the reason when the choice cannot be honoured. held: whether an emulated text goes out as a held key, from the system layout's keystroke (step, null when it cannot type it) and what the hand holds.",
	"resolve": [
		{
			"name": "an empty configuration keeps the physical place",
			"layout": {},
			"expected": { "choice": "physical", "apps": {} }
		},
		{
			"name": "the global choice and the applications are read",
			"layout": { "game_keys": "letters", "game_keys_apps": { "unciv": "physical" } },
			"expected": { "choice": "letters", "apps": { "unciv": "physical" } }
		},
		{
			"name": "a choice written in another case takes the manifest spelling",
			"layout": { "game_keys": "Letters" },
			"expected": { "choice": "letters", "apps": {} }
		},
		{
			"name": "an unknown choice reads as the default",
			"layout": { "game_keys": "wasd" },
			"expected": { "choice": "physical", "apps": {} }
		},
		{
			"name": "an application table holding an unknown choice reads as none",
			"layout": { "game_keys_apps": { "game.exe": "both" } },
			"expected": { "choice": "physical", "apps": {} }
		}
	],
	"choice_for": [
		{
			"name": "an application without its own choice follows the global one",
			"platform": "windows",
			"settings": { "choice": "physical", "apps": { "game.exe": "letters" } },
			"app": "notepad.exe",
			"expected": { "choice": "physical", "overridden": false }
		},
		{
			"name": "a Windows executable ignores case",
			"platform": "windows",
			"settings": { "choice": "physical", "apps": { "game.exe": "letters" } },
			"app": "Game.EXE",
			"expected": { "choice": "letters", "overridden": true }
		},
		{
			"name": "a Linux WM class ignores case",
			"platform": "linux",
			"settings": { "choice": "letters", "apps": { "unciv": "physical" } },
			"app": "Unciv",
			"expected": { "choice": "physical", "overridden": true }
		},
		{
			"name": "a macOS bundle identifier is exact",
			"platform": "macos",
			"settings": { "choice": "physical", "apps": { "com.example.Game": "letters" } },
			"app": "com.example.game",
			"expected": { "choice": "physical", "overridden": false }
		},
		{
			"name": "no application follows the global choice",
			"platform": "linux",
			"settings": { "choice": "letters", "apps": { "unciv": "physical" } },
			"app": null,
			"expected": { "choice": "letters", "overridden": false }
		}
	],
	"apps_with": [
		{
			"name": "an application gets its own choice under its stored key",
			"platform": "windows",
			"settings": { "choice": "physical", "apps": {} },
			"app": "Game.exe",
			"choice": "letters",
			"expected": { "game.exe": "letters" }
		},
		{
			"name": "a new choice replaces the one stored in another case",
			"platform": "linux",
			"settings": { "choice": "physical", "apps": { "Unciv": "letters" } },
			"app": "unciv",
			"choice": "physical",
			"expected": { "unciv": "physical" }
		},
		{
			"name": "following the global choice again removes the entry",
			"platform": "macos",
			"settings": {
				"choice": "physical",
				"apps": { "com.example.Game": "letters", "com.other": "physical" }
			},
			"app": "com.example.Game",
			"choice": null,
			"expected": { "com.other": "physical" }
		}
	],
