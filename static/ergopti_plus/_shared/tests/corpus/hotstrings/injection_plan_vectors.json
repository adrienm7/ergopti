				"trigger_len": 2,
				"event_len": 1,
				"event_on_screen": true,
				"replacement": "cab",
				"terminator": " ",
				"consume_terminator": true,
				"cascade": { "replacement": "cZ", "trigger_len": 3, "tail": null, "final_result": false }
			},
			"expect": {
				"erase": 4,
				"text": "cZ",
