		{
			"id": "dvorak",
			"base": { "KeyQ": "'", "KeyW": ",", "KeyA": "a", "KeyY": "f" },
			"expected": "★",
			"family": null
		},
		{ "id": "unreadable-layout", "base": {}, "expected": "★", "family": null }
