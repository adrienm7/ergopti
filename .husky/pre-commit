#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Sort and format any staged hotstring TOML files before committing.
# Only processes files that are actually staged to avoid touching unrelated
# files in the working tree. Re-stages each file after formatting so the
# commit includes the sorted version without requiring a manual git add.

HOTSTRING_PATTERN="static/ergopti_plus/_shared/modules/hotstrings/*.toml"
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^static/ergopti_plus/_shared/modules/hotstrings/[^/]+\.toml$' || true)

if [ -n "$STAGED" ]; then
    for f in $STAGED; do
        python tools/format_toml.py --hotstrings "$f"
        git add "$f"
    done
fi

# AHK encoding — add UTF-8 BOM and normalise to LF on any staged .ahk file that
# is missing them. AHK v2 silently aborts mid-file when the BOM is absent, which
# causes silent CI failures with no error message; the LF half keeps one
# line-ending convention repo-wide so no mixed-ending parser edge case can hide a
# test. Both halves are exactly what tools/test/test-ahk-encoding.cjs enforces.
# The fixer reads Git's NUL-delimited staged destinations, validates that every
# selected path is a regular in-repository AHK file, and re-stages only those
# destinations. Unstaged AHK files are never scanned or rewritten; a partially
# staged destination fails before any file or index entry is changed.
node tools/deploy/fix-ahk-encoding.cjs --staged

# Location-pinned source reads in macOS tests — block them at the source rather
# than discovering them later via the JS ratchet. A test that reads a driver file
# through driver_root() .. "some/path.lua" breaks the moment that module is
# renamed or split, turning a useful invariant into a path error. The fixer
# converts the common shape automatically; it refuses, loudly, when the target
# module has no declaration unique across the production tree, because
# read_driver_source would then return several files concatenated and silently
# change what a position-comparing assertion means.
STAGED_LUA_TESTS=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^static/ergopti_plus/macos/tests/.*\.lua$' || true)
if [ -n "$STAGED_LUA_TESTS" ]; then
    if ! node tools/lint/fix-pinned-source-reads.cjs; then
        echo ""
        echo "[pre-commit] Run 'npm run fix:pinned-reads' to convert them, then re-stage."
        exit 1
    fi
fi

# Identity — refuse any added line that holds this machine's home folder,
# directory login with its domain, domain or host name, whatever the file:
# field report evidence once published a company login this way. The values
# are read from the machine at commit time; the repository holds none.
# The first Python that runs: python3 is a Store stub on a Windows without it.
IDENTITY_PYTHON=python3
python3 -c '' 2>/dev/null || IDENTITY_PYTHON=python
"$IDENTITY_PYTHON" tools/dev/field-report-redact.py --staged || exit 1

# Formatting — Prettier and Ruff rewrite the staged files they own and
# re-stage them, so every commit carries formatted bytes; CI's check then
# never finds a diff. A staged file with unstaged changes is refused.
node tools/lint/format.cjs --staged

# Lint coding conventions — blocks commit on any violation.
node tools/lint/lint-conventions.js --fail-on-violations
