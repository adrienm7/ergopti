+	"expected_count": 165,
+	"cohorts": [
+		{
+			"class_name": "KarabinerLeaseWorkerTests",
+			"source": "static/ergopti_plus/macos/launcher/Tests/ErgoptiPlusTests/RemapLeaseWorkerTests.swift",
+			"names": [
