ections":1028},"Axes continus",[1029],{"title":212,"actions":1030},[1031,1034,1037,1040,1043,1046,1049,1052,1055,1058,1061,1064,1067,1070,1073,1076],{"id":1032,"label":1033,"platform":363,"axis":227},"tabs","⧉ Onglets",{"id":1035,"label":1036,"platform":363,"axis":227},"char","A Lettres",{"id":1038,"label":1039,"platform":363,"axis":227},"char_sel","✎ A Sél. Lettres",{"id":1041,"label":1042,"platform":363,"axis":227},"line_arrow","↕ Lignes (Flèches)",{"id":1044,"label":1045,"platform":363,"axis":227},"line_sel","✎ ↕ Sél. Lignes",{"id":1047,"label":1048,"platform":363,"axis":227},"words","W Mots",{"id":1050,"label":1051,"platform":363,"axis":227},"words_sel","✎ W Sél. Mots",{"id":1053,"label":1054,"platform":363,"axis":227},"windows","◱ Fenêtres",{"id":1056,"label":1057,"platform":363,"axis":227},"spaces","▢ Spaces",{"id":1059,"label":1060,"platform":363,"axis":227},"volume","🔊 Volume",{"id":1062,"label":1063,"platform":363,"axis":227},"brightness","☀ Luminosité",{"id":1065,"label":1066,"platform":363,"axis":227},"tracks","♫ Pistes",{"id":1068,"label":1069,"platform":363,"axis":227},"lines","↕ Lignes (Alt)",{"id":1071,"label":1072,"platform":363,"axis":227},"line_bounds","↔ Ligne (début/fin)",{"id":1074,"label":1075,"platform":363,"axis":227},"paragraphs","¶ Paragraphes",{"id":1077,"label":1078,"platform":363,"axis":227},"document","📄 Document (début/fin)",[1080,1084],{"id":1081,"name":1081,"description":1082,"icon":1083},"App Cloner","Clonez n'importe quelle application (VS Code, Slack…) : le clone reçoit sa propre icône teintée, son nom et son profil isolé. Plusieurs instances vraiment séparées, sans droits admin.","\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 1024\" width=\"1024\" height=\"1024\">\n\t\u003C!--\n\t\tAppCloner icon — three overlapping rounded squares in red, green, blue,\n\t\tstacked diagonally on a dark slate background. Visual metaphor: the same\n\t\tapp cloned in multiple tinted colours, which is exactly what the tool\n\t\tdoes. The translucent stack reads from any size (Dock 32 px → Finder\n\t\t1024 px) and remains balanced because the shapes share a common centre.\n\t-->\n\t\u003Cdefs>\n\t\t\u003Cfilter id=\"shadow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n\t\t\t\u003CfeGaussianBlur in=\"SourceAlpha\" stdDeviation=\"14\"/>\n\t\t\t\u003CfeOffset dx=\"0\" dy=\"10\" result=\"offsetblur\"/>\n\t\t\t\u003CfeComponentTransfer>\u003CfeFuncA type=\"linear\" slope=\"0.35\"/>\u003C/feComponentTransfer>\n\t\t\t\u003CfeMerge>\u003CfeMergeNode/>\u003CfeMergeNode in=\"SourceGraphic\"/>\u003C/feMerge>\n\t\t\u003C/filter>\n\t\t\u003ClinearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n\t\t\t\u003Cstop offset=\"0\" stop-color=\"#2A3142\"/>\n\t\t\t\u003Cstop offset=\"1\" stop-color=\"#1B2030\"/>\n\t\t\u003C/linearGradient>\n\t\u003C/defs>\n\n\t\u003C!-- App-icon shaped background -->\n\t\u003Crect width=\"1024\" height=\"1024\" rx=\"220\" ry=\"220\" fill=\"url(#bg)\"/>\n\n\t\u003C!-- Three tinted clones, staggered. Same shape, different hues — the\n\t\t visual metaphor for what AppCloner produces. -->\n\t\u003Cg filter=\"url(#shadow)\">\n\t\t\u003C!-- Back clone: red, top-left -->\n\t\t\u003Crect x=\"180\" y=\"180\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#E74C3C\" opacity=\"0.95\"/>\n\t\t\u003C!-- Middle clone: green -->\n\t\t\u003Crect x=\"262\" y=\"262\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#2ECC71\" opacity=\"0.95\"/>\n\t\t\u003C!-- Front clone: blue, bottom-right -->\n\t\t\u003Crect x=\"344\" y=\"344\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#3498DB\" opacity=\"0.95\"/>\n\t\u003C/g>\n\n\t\u003C!-- Subtle highlight on the front clone for depth -->\n\t\u003Crect x=\"344\" y=\"344\" width=\"500\" height=\"160\" rx=\"110\" ry=\"110\"\n\t      fill=\"#FFFFFF\" opacity=\"0.10\"/>\n\u003C/svg>\n",{"id":1085,"name":1085,"description":1086,"icon":1087},"Encryptor","Déposez un fichier sur l'icône : il est chiffré en AES-256 (extension .enc). Redéposez-le : il est déchiffré. Aucun réglage, rien à apprendre.","\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 1024\" width=\"1024\" height=\"1024\">\n  \u003Crect width=\"1024\" height=\"1024\" rx=\"220\" ry=\"220\" fill=\"#1A3A5C\"/>\n  \u003Crect x=\"312\" y=\"460\" rx=\"60\" ry=\"60\" width=\"400\" height=\"300\" fill=\"#4A90D9\"/>\n  \u003Cpath d=\"M 362 460 L 362 380 Q 362 220 512 220 Q 662 220 662 380 L 662 460\" stroke=\"#FFFFFF\" stroke-width=\"60\" fill=\"none\" stroke-linecap=\"round\"/>\n  \u003Ccircle cx=\"512\" cy=\"610\" r=\"50\" fill=\"#FFFFFF\"/>\n  \u003Crect x=\"492\" y=\"610\" rx=\"10\" ry=\"10\" width=\"40\" height=\"70\" fill=\"#FFFFFF\"/>\n\u003C/svg>\n"],"uses":{}}]}
