+/** Caller writes cannot overlap any owner field, including lock/FIFO/routes. */
+static bool NavTerminalOutputAliasesState(const void *output, size_t bytes)
+{
+	uintptr_t begin = (uintptr_t)output, owned = (uintptr_t)&g_nav_state;
+	if (bytes == 0) return false;
+	if (bytes > UINTPTR_MAX - begin || sizeof(g_nav_state) > UINTPTR_MAX - owned)
+		return true;
+	return begin < owned + sizeof(g_nav_state) && owned < begin + bytes;
+}
