			"macos_symbol": "⌥"
		},
		"left_alt": { "i18n": "key_name.left_alt", "platforms": { "macos": "key_name.left_option" } },
		"alt_gr": { "i18n": "key_name.alt_gr" },
		"win": { "i18n": "key_name.win", "platforms": { "linux": "key_name.super" } },
		"super": { "i18n": "key_name.super" },
