	"physical": {
		"_comment": "How a physical position (the W3C codes of physical_keys.json) reads in a row: KeyA as A, Digit1 as 1, F5 as F5, a sign position as its US legend, a numpad position through `numpad` (« Pavé num. 7 »), every other code as the key it names here (PageUp is page_up). The physical layer is position-based, so the legend is the position's, not the active layout's.",
		"numpad": "key_name.numpad",
		"legends": {
			"Backquote": "`",
			"Minus": "-",
			"Equal": "=",
			"BracketLeft": "[",
			"BracketRight": "]",
			"Backslash": "\\",
			"Semicolon": ";",
			"Quote": "'",
			"IntlBackslash": "<",
			"Comma": ",",
			"Period": ".",
			"Slash": "/",
			"NumpadDivide": "/",
			"NumpadMultiply": "*",
			"NumpadSubtract": "-",
			"NumpadAdd": "+",
			"NumpadDecimal": "."
		}
	},
