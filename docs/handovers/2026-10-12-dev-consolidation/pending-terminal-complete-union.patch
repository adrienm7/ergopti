+				|| NumGet(Packets, Offset + 4, "UInt") != 0
+				|| NumGet(Packets, Offset + 8, "UShort") != Vk
+				|| NumGet(Packets, Offset + 10, "UShort") != Code
+				|| NumGet(Packets, Offset + 12, "UInt") != Flags
+				|| NumGet(Packets, Offset + 16, "UInt64") != 0
