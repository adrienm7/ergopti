{
	"_comment": "The diagnostics window's snapshot, version 2, produced by the three drivers and rendered and exported by the shared page (_shared/ui/healthcheck/model.js). A snapshot is { schema_version, driver, generated_at (UTC, ISO 8601), detailed, sections: { <section id>: { <field id>: value } or { items: [ ... ] } }, probes: { <probe id>: { state, ms, detail } } }. Sections render in this order; a section or a field whose `platforms` omits the driver is neither collected nor shown there. Labels come from the locales: healthcheck.section.<id>, healthcheck.field.<id>, healthcheck.column.<section>.<column>. Field types: text, path (the page offers Open; the host opens it by field id only, never by a path the page sends), count, bytes, seconds, ms, percent (0 to 100, of the whole machine's processor capacity), bool (true, or 1 from the AHK writer), list, log (an H3 and a block), enum (translated through enum_key + value). A field with `probe` is filled by that asynchronous probe and reads as pending until the probe answers; `probe` is a probe id, or a map from driver to probe id when only some drivers need one; show_ms appends the probe's duration. The cpu_load probe takes two samples sample_ms apart, on a timer. An items section with `probe` lists what phase A read and says its list is incomplete until that probe answers with the whole list (macOS reads its Bluetooth devices with system_profiler). A field marked opt_in, and an items column in opt_in_columns, is collected and shown only when the user ticks 'Include details'. Phase A, the synchronous collection, must stay under phase_a_budget_ms and may only read memory, cached values and small files: every subprocess, network request or slow system query is a probe bounded by its timeout_ms. `permissions` lists, per driver, the permission ids the host reports, the system settings page it opens for one (by id) and whether a fix hint (healthcheck.permission_fix.<id>) exists. `report` bounds the Markdown file the page asks the host to save under the logs folder.",
	"schema_version": 2,
	"diagnostic_checks": {
		"items": [
			{
				"id": "schema_fields",
				"label": "healthcheck.deep_tests.schema",
				"scope": "diagnostics-model"
			},
			{
				"id": "probe_inventory",
				"label": "healthcheck.deep_tests.probe_inventory",
				"scope": "diagnostics-model"
			},
			{
				"id": "redaction",
				"label": "healthcheck.deep_tests.redaction",
				"scope": "synthetic-export"
			},
			{
				"id": "driver_suites",
				"label": "healthcheck.deep_tests.ci_suites",
				"scope": "isolated-suite",
				"reason": "not_embedded"
			},
			{
				"id": "install_reload_profile",
				"label": "healthcheck.deep_tests.ci_suites",
				"scope": "isolated-suite",
				"reason": "isolated_environment_required"
			}
		],
		"redaction_vector": {
			"context": {
				"home": "/diagnostics-user",
				"user": "diagnostics-user",
				"case_insensitive": false
			},
			"input": "location /diagnostics-user/config; account diagnostics-user; api_key=diagnostic_key_123456789",
			"expected": "location ~/config; account <user>; api_key=<secret>"
		}
	},
	"phase_a_budget_ms": 5,
	"max_export_bytes": 2097152,
	"report": {
		"subdir": "diagnostics",
		"name_prefix": "ergopti-diagnostics-",
		"name_suffix": ".md",
		"name_max_length": 160,
		"export_sequence_max": 9007199254740991
	},
	"probes": {
		"github_api": {
			"timeout_ms": 8000,
			"url": "https://api.github.com/rate_limit"
		},
		"ai_health": {
			"timeout_ms": 4000,
			"paths": {
				"ollama": "/api/version",
				"mlx": "/v1/models"
			}
		},
		"system_details": {
			"timeout_ms": 4000,
			"platforms": ["macos", "linux"]
		},
		"cpu_load": {
			"timeout_ms": 4000,
			"sample_ms": 1000
		},
		"bluetooth": {
			"timeout_ms": 10000,
			"platforms": ["macos"]
		},
		"appleevent_transport": {
			"label": "healthcheck.deep_tests.appleevents",
			"platforms": ["macos"],
			"timeout_ms": 10000
		}
	},
	"permissions": {
		"macos": {
			"accessibility": {
				"settings": "x-apple.systempreferences:com.apple.preference.security?Privacy_Accessibility"
			},
			"screen_recording": {
				"settings": "x-apple.systempreferences:com.apple.preference.security?Privacy_ScreenCapture"
			},
			"input_monitoring": {
				"settings": "x-apple.systempreferences:com.apple.preference.security?Privacy_ListenEvent"
