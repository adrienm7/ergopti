{
	"_comment": "How many backend calls one prediction request takes, replayed through _shared/lua/llm/request_plan/batching.lua by the macOS and Linux runners. A batch profile asks once for every variant when more than one is requested; every other case asks once per variant. This is the rule of llm/profile_selector.lua (a batch prompt is a batch only above one prediction). per_call is the number of variants one call returns, which also scales that call's token budget. expect_error is a substring of the message the plan must raise.",
	"vectors": [
		{
			"id": "a-batch-profile-asks-once-for-every-variant",
			"batch_profile": true,
			"requested": 3,
			"expect": {
				"mode": "batch",
				"calls": 1,
				"per_call": 3
			}
		},
		{
			"id": "a-batch-profile-with-one-prediction-is-a-single-call",
			"batch_profile": true,
			"requested": 1,
			"expect": {
				"mode": "sequential",
				"calls": 1,
				"per_call": 1
			}
		},
		{
			"id": "a-plain-profile-asks-once-per-variant",
			"batch_profile": false,
			"requested": 3,
			"expect": {
				"mode": "sequential",
				"calls": 3,
				"per_call": 1
			}
		},
		{
			"id": "a-plain-profile-with-one-prediction",
			"batch_profile": false,
			"requested": 1,
			"expect": {
				"mode": "sequential",
				"calls": 1,
				"per_call": 1
			}
		},
		{
			"id": "a-batch-profile-with-two-predictions",
			"batch_profile": true,
			"requested": 2,
			"expect": {
				"mode": "batch",
				"calls": 1,
				"per_call": 2
			}
		},
		{
			"id": "a-non-boolean-flag-is-refused",
			"batch_profile": "yes",
			"requested": 1,
			"expect_error": "batch_profile"
		},
		{
			"id": "zero-predictions-are-refused",
			"batch_profile": false,
			"requested": 0,
			"expect_error": "requested"
		},
		{
			"id": "a-fractional-count-is-refused",
			"batch_profile": false,
			"requested": 1.5,
			"expect_error": "requested"
		}
	]
}
