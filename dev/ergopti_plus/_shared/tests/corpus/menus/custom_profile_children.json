	"declaration": [
		{
			"type": "check",
			"id": "llm_profile_use",
			"i18n": "menu.profiles.use_profile",
			"checked_when": ["llm_custom_profile_active"],
			"disabled_when": ["llm_custom_profile_ready"],
			"platforms": ["hs", "linux"],
			"unavailable": "hide"
		},
		{
			"type": "command",
			"id": "llm_profile_shortcut",
