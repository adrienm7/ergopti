te background. Visual metaphor: the same\n\t\tapp cloned in multiple tinted colours, which is exactly what the tool\n\t\tdoes. The translucent stack reads from any size (Dock 32 px → Finder\n\t\t1024 px) and remains balanced because the shapes share a common centre.\n\t-->\n\t\u003Cdefs>\n\t\t\u003Cfilter id=\"shadow\" x=\"-20%\" y=\"-20%\" width=\"140%\" height=\"140%\">\n\t\t\t\u003CfeGaussianBlur in=\"SourceAlpha\" stdDeviation=\"14\"/>\n\t\t\t\u003CfeOffset dx=\"0\" dy=\"10\" result=\"offsetblur\"/>\n\t\t\t\u003CfeComponentTransfer>\u003CfeFuncA type=\"linear\" slope=\"0.35\"/>\u003C/feComponentTransfer>\n\t\t\t\u003CfeMerge>\u003CfeMergeNode/>\u003CfeMergeNode in=\"SourceGraphic\"/>\u003C/feMerge>\n\t\t\u003C/filter>\n\t\t\u003ClinearGradient id=\"bg\" x1=\"0\" y1=\"0\" x2=\"0\" y2=\"1\">\n\t\t\t\u003Cstop offset=\"0\" stop-color=\"#2A3142\"/>\n\t\t\t\u003Cstop offset=\"1\" stop-color=\"#1B2030\"/>\n\t\t\u003C/linearGradient>\n\t\u003C/defs>\n\n\t\u003C!-- App-icon shaped background -->\n\t\u003Crect width=\"1024\" height=\"1024\" rx=\"220\" ry=\"220\" fill=\"url(#bg)\"/>\n\n\t\u003C!-- Three tinted clones, staggered. Same shape, different hues — the\n\t\t visual metaphor for what AppCloner produces. -->\n\t\u003Cg filter=\"url(#shadow)\">\n\t\t\u003C!-- Back clone: red, top-left -->\n\t\t\u003Crect x=\"180\" y=\"180\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#E74C3C\" opacity=\"0.95\"/>\n\t\t\u003C!-- Middle clone: green -->\n\t\t\u003Crect x=\"262\" y=\"262\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#2ECC71\" opacity=\"0.95\"/>\n\t\t\u003C!-- Front clone: blue, bottom-right -->\n\t\t\u003Crect x=\"344\" y=\"344\" width=\"500\" height=\"500\" rx=\"110\" ry=\"110\"\n\t\t      fill=\"#3498DB\" opacity=\"0.95\"/>\n\t\u003C/g>\n\n\t\u003C!-- Subtle highlight on the front clone for depth -->\n\t\u003Crect x=\"344\" y=\"344\" width=\"500\" height=\"160\" rx=\"110\" ry=\"110\"\n\t      fill=\"#FFFFFF\" opacity=\"0.10\"/>\n\u003C/svg>\n",{"id":924,"name":924,"description":925,"icon":926},"Encryptor","Déposez un fichier sur l'icône : il est chiffré en AES-256 (extension .enc). Redéposez-le : il est déchiffré. Aucun réglage, rien à apprendre.","\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1024 1024\" width=\"1024\" height=\"1024\">\n  \u003Crect width=\"1024\" height=\"1024\" rx=\"220\" ry=\"220\" fill=\"#1A3A5C\"/>\n  \u003Crect x=\"312\" y=\"460\" rx=\"60\" ry=\"60\" width=\"400\" height=\"300\" fill=\"#4A90D9\"/>\n  \u003Cpath d=\"M 362 460 L 362 380 Q 362 220 512 220 Q 662 220 662 380 L 662 460\" stroke=\"#FFFFFF\" stroke-width=\"60\" fill=\"none\" stroke-linecap=\"round\"/>\n  \u003Ccircle cx=\"512\" cy=\"610\" r=\"50\" fill=\"#FFFFFF\"/>\n  \u003Crect x=\"492\" y=\"610\" rx=\"10\" ry=\"10\" width=\"40\" height=\"70\" fill=\"#FFFFFF\"/>\n\u003C/svg>\n"],"uses":{}}]}
