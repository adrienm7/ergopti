{
	"name": "svelte-static",
	"version": "3.0.0",
	"private": true,
	"scripts": {
		"predev": "node ./tools/dev/write-branch.js",
		"dev": "vite dev",
		"prebuild": "node ./tools/dev/write-branch.js",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"prepare": "husky install",
		"build:manifest": "node ./tools/build/build-features-manifest.js",
		"build:domain": "node ./tools/build/build-domain.cjs",
		"codegen": "npm run build:domain",
		"lint:banners": "node ./tools/lint/audit-banner-alignment.js static/ergopti_plus/_shared",
		"lint:conventions": "node ./tools/lint/lint-conventions.js --warn-only",
		"lint:conventions:strict": "node ./tools/lint/lint-conventions.js --fail-on-violations",
		"test:port-compliance": "node ./tools/test/test-port-compliance.cjs",
		"test:no-fallbacks": "node ./tools/test/test-no-fallback-literals.cjs",
		"test:priority-parity": "node ./tools/test/test-priority-parity.cjs",
		"test:manifest-parity": "node ./tools/test/test-manifest-parity.cjs",
		"test:config-schema": "node ./tools/test/test-config-schema.cjs",
		"test:ahk-encoding": "node ./tools/test/test-ahk-encoding.cjs",
		"test:click-lock": "node ./tools/test/test-click-lock-fix.cjs",
		"test:ui-focus": "node ./tools/test/test-ui-focus-fix.cjs",
		"test:hs-integrity": "node ./tools/test/test-hammerspoon-integrity.cjs",
		"test:diagnostic-ui": "node ./tools/test/test-diagnostic-ui-integrity.cjs",
		"test:manifest-equivalence": "node ./tools/test/test-manifest-equivalence.cjs",
		"test:feature-read-sites": "node ./tools/test/test-feature-read-sites.js",
		"test:architecture": "node ./tools/test/test-architecture-diagram.cjs",
		"test:dev-tool-paths": "node ./tools/test/test-dev-tool-paths.cjs",
		"test:macos-bundle-layout": "node ./tools/test/test-macos-bundle-layout.cjs",
		"test:js": "node ./tools/test/run-js-suite.cjs",
		"test:hs": "cd static/ergopti_plus/macos && lua tests/run.lua",
		"test:linux": "cd static/ergopti_plus/linux && luajit tests/run.lua",
		"test:properties": "node ./tools/test/test-properties.cjs",
		"fix:banners": "node ./tools/lint/lint-conventions.js --fix-banners --warn-only",
		"fix:spacing": "node ./tools/lint/lint-conventions.js --fix-spacing --warn-only",
		"fix:unbalanced": "node ./tools/lint/lint-conventions.js --fix-unbalanced --warn-only",
		"fix:all": "node ./tools/lint/lint-conventions.js --fix-banners --fix-unbalanced --fix-spacing --warn-only",
		"install:hammerspoon": "bash ./tools/dev/install-hammerspoon.sh",
		"sync:ahk": "node ./tools/dev/sync-private-ahk.js && node ./tools/dev/remove_ahk_personal_configuration.js",
		"watch:ahk": "node ./tools/dev/watch-ahk.js",
		"gen:diagram": "node ./tools/codegen/gen-architecture-diagram.cjs",
		"new:driver": "node ./tools/codegen/new-driver.js",
		"bench:hotstring": "node ./tools/build/bench-hotstring.cjs",
		"codegen:registry": "node ./tools/codegen/codegen-registry-ahk.cjs",
		"codegen:expander:ahk": "node ./tools/codegen/codegen-expander-ahk.cjs",
		"codegen:terminators": "node ./tools/codegen/codegen-terminators.cjs",
		"codegen:prompt-builder:ahk": "node ./tools/codegen/codegen-prompt-builder-ahk.cjs",
		"codegen:prompt-builder:hs": "node ./tools/codegen/codegen-prompt-builder-hs.cjs",
		"codegen:contracts": "node ./tools/codegen/codegen-contracts-json.cjs",
		"test:mutation": "stryker run"
	},
	"type": "module",
	"dependencies": {
		"aos": "^3.0.0-beta.6",
		"modern-normalize": "^3.0.1",
		"tocbot": "^4.30.0"
	},
	"devDependencies": {
		"@samkirkland/ftp-deploy": "^1.2.4",
		"@stryker-mutator/core": "^9.6.1",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/enhanced-img": "^0.8.1",
		"@sveltejs/kit": "^2.53.4",
		"@types/aos": "^3.0.7",
		"fast-check": "^4.8.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.1.5",
		"pm2": "^5.4.3",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-svelte": "^3.4.0",
		"smol-toml": "^1.3.0",
		"svelte": "^5.53.7",
		"vite": "^7.2.2"
	}
}
