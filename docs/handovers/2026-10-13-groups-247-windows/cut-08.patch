+/** A committed requester withdrawal must survive the held model-consent dialog. */
+_LAG_RequesterWithdrawal(Mode) {
+	_LAG_Run(_LAG_Menu("action", "", "local", Mode != "prediction-off"), _LTN_Screen(LAG_SELECTION), Body)
+	Body(Fx, Lines, Sent) {
