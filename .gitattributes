* text=auto eol=lf

# Force LF for shell scripts and macOS/Linux source files
*.sh text eol=lf
*.applescript text eol=lf
*.lua text eol=lf
*.py text eol=lf

# AHK v2 source uses UTF-8 BOM + LF. Keep the parser invariant identical on
# Windows and Linux CI, and reject mixed line endings in the encoding gate.
*.ahk text eol=lf

# Markdown must check out LF everywhere. Generated docs (e.g. the architecture
# diagram) are compared byte-for-byte by CI; with core.autocrlf=true a Windows
# checkout would rewrite them to CRLF and fail that comparison locally even
# though the committed blob is LF and CI (Linux/macOS) passes.
*.md text eol=lf

# Same reasoning, extended to the formats the generators emit. Every codegen in
# tools/ writes LF, and six of the twelve tracked generated files are .json or
# .toml — without a rule they check out CRLF on Windows and present as modified
# with an empty `git diff`, which is the state this repo was in. It also forces
# per-gate workarounds: test-port-compliance.cjs carries a hand-rolled
# normalizeEol() with a comment explaining exactly this.
*.json text eol=lf
*.toml text eol=lf
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf

# systemd units and Arch PKGBUILDs are consumed by Linux tooling only.
*.service text eol=lf
PKGBUILD text eol=lf

# Test fixtures whose bytes are asserted.
*.ini text eol=lf
*.kbd text eol=lf
*.tsv text eol=lf
