			"family": "azerty"
		},
		{
			"id": "us-qwerty",
			"base": { "KeyQ": "q", "KeyW": "w", "KeyA": "a", "KeyY": "y", "Semicolon": ";" },
			"expected": ";",
			"family": "qwerty"
		},
		{
			"id": "uk-qwerty",
			"base": { "KeyQ": "q", "KeyW": "w", "KeyA": "a", "KeyY": "y" },
			"expected": ";",
			"family": "qwerty"
		},
		{
			"id": "german-qwertz",
