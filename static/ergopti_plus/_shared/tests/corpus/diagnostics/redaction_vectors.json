{
	"description": "Golden vectors for diagnostics redaction with the rules of _shared/modules/diagnostics/redaction.json. `context` is the platform's home folder, account name and whether its paths compare case-insensitively (Windows). Replayed by the macOS and Linux Lua suites and the AHK suite.",
	"vectors": [
		{
			"id": "mac_home_everywhere_in_free_text",
			"context": { "home": "/Users/jdoe", "user": "jdoe", "case_insensitive": false },
			"input": "config_dir: /Users/jdoe/.config/ergopti_plus\nlog: /Users/jdoe/Library/Logs/ergopti_plus/ErgoptiPlus_errors_2026-09-23.log",
			"expected": "config_dir: ~/.config/ergopti_plus\nlog: ~/Library/Logs/ergopti_plus/ErgoptiPlus_errors_2026-09-23.log"
		},
		{
			"id": "home_alone_and_trailing_slash_in_context",
			"context": { "home": "/home/jdoe/", "user": "jdoe", "case_insensitive": false },
			"input": "HOME=/home/jdoe and cwd /home/jdoe/",
			"expected": "HOME=~ and cwd ~/"
		},
		{
			"id": "a_sibling_folder_is_another_account_not_the_home",
			"context": { "home": "/home/jdoe", "user": "jdoe", "case_insensitive": false },
			"input": "/home/jdoe2/notes and /home/jdoe-backup and /home/jdoe.old",
			"expected": "/home/<user>/notes and /home/<user> and /home/<user>"
		},
		{
			"id": "windows_home_both_slashes_any_case",
			"context": { "home": "C:\\Users\\JDoe", "user": "JDoe", "case_insensitive": true },
			"input": "C:\\Users\\JDoe\\AppData\\Local\\ergopti_plus\\logs and c:/users/jdoe/Documents and C:\\USERS\\JDOE",
			"expected": "~\\AppData\\Local\\ergopti_plus\\logs and ~/Documents and ~"
		},
		{
			"id": "account_name_outside_the_home",
			"context": { "home": "/Users/jdoe", "user": "jdoe", "case_insensitive": false },
			"input": "/Volumes/jdoe/Backups owned by jdoe (jdoe@example)",
			"expected": "/Volumes/<user>/Backups owned by <user> (<user>@example)"
		},
		{
			"id": "account_name_only_as_a_whole_word",
			"context": { "home": "/Users/ann", "user": "ann", "case_insensitive": false },
			"input": "ann wrote an annotation for Ann, anna and joann; ann_x stays",
			"expected": "<user> wrote an annotation for Ann, anna and joann; ann_x stays"
		},
		{
			"id": "account_name_case_folded_on_windows",
			"context": { "home": "C:\\Users\\Admin", "user": "Admin", "case_insensitive": true },
			"input": "D:\\Shares\\admin\\x and ADMIN but not administrator",
			"expected": "D:\\Shares\\<user>\\x and <user> but not administrator"
		},
		{
			"id": "short_account_name_is_never_redacted",
			"context": { "home": "/home/al", "user": "al", "case_insensitive": false },
			"input": "al at /home/al/x and /srv/al",
			"expected": "al at ~/x and /srv/al"
		},
		{
			"id": "no_context_still_redacts_another_accounts_profile",
			"context": {},
			"input": "/Users/jdoe/file is another account's profile when nothing is known; /opt/data stays",
			"expected": "/Users/<user>/file is another account's profile when nothing is known; /opt/data stays"
		},
		{
			"id": "token_prefixes",
			"context": {},
			"input": "openai sk-abcdefghijklmnopqrstuv github ghp_ABCDEFGHIJKLMNOPQRSTUVWX pat github_pat_11ABCDEFG_0123456789abcdef hf hf_abcdefghijklmnopqrstuvwxyz google AIzaSyA1234567890abcdefghijklmnopqrs",
			"expected": "openai <secret> github <secret> pat <secret> hf <secret> google <secret>"
		},
		{
			"id": "token_prefix_needs_a_long_body_and_a_word_start",
			"context": {},
			"input": "sk-short task-abcdefghijklmnopqrstuvwxyz disk-cache ghp_tooShort",
			"expected": "sk-short task-abcdefghijklmnopqrstuvwxyz disk-cache ghp_tooShort"
		},
		{
			"id": "bearer_credential",
			"context": {},
			"input": "Authorization: Bearer abc.DEF-123_xyz/+= next; bearer short",
			"expected": "Authorization: Bearer <secret> next; bearer short"
		},
		{
			"id": "key_value_secrets",
			"context": {},
			"input": "api_key=abcdef123456&x=1 password: hunter22 {\"token\": \"zyxwvu98\"} Api-Key = 'q1w2e3r4'",
			"expected": "api_key=<secret>&x=1 password: <secret> {\"token\": \"<secret>\"} Api-Key = '<secret>'"
		},
		{
			"id": "key_value_needs_a_whole_key_and_a_long_value",
			"context": {},
			"input": "max_tokens=512 tokens: 12345678 token_count=99 token: 12345 access_token=aaaaaaaa",
			"expected": "max_tokens=512 tokens: 12345678 token_count=99 token: 12345 access_token=<secret>"
		},
		{
			"id": "secret_containing_the_account_name_is_removed_whole",
			"context": { "home": "/Users/jdoe", "user": "jdoe", "case_insensitive": false },
			"input": "token=jdoe-4f5a6b7c at /Users/jdoe",
			"expected": "token=<secret> at ~"
		},
		{
			"id": "non_ascii_text_is_kept_byte_for_byte",
			"context": { "home": "/Users/zoé", "user": "zoé", "case_insensitive": false },
			"input": "Préférences de zoé dans /Users/zoé/Library — ✓ 😀",
			"expected": "Préférences de <user> dans ~/Library — ✓ 😀"
		},
		{
			"id": "email_addresses",
			"context": {},
			"input": "mail jane.doe+tag@example.co.uk, or bob_x@sub.mail-host.org. Also (a@b.io) end.",
			"expected": "mail <email>, or <email>. Also (<email>) end."
		},
		{
			"id": "email_needs_a_dotted_domain_and_a_letter_tld",
			"context": {},
			"input": "user@localhost jdoe@example v@1.23 @handle a@b.c x@.com",
			"expected": "user@localhost jdoe@example v@1.23 @handle a@b.c x@.com"
		},
		{
			"id": "url_credentials",
			"context": {},
			"input": "git clone https://jdoe:hunter22@github.com/o/r.git and ftp://anon@host/x but https://github.com/o/r and http://localhost:11434.",
			"expected": "git clone https://<secret>@github.com/o/r.git and ftp://<secret>@host/x but https://github.com/o/r and http://localhost:11434."
		},
		{
			"id": "url_without_credentials_is_kept",
			"context": {},
			"input": "http://[::1]:8080/a@b and https://x.test/path?next=a@b.test",
			"expected": "http://[::1]:8080/a@b and https://x.test/path?next=<email>"
		},
		{
			"id": "another_accounts_profile_every_style",
			"context": {},
			"input": "C:\\Users\\Other\\AppData\\x, d:\\users\\third.party\\y, /Users/bob/z, /home/ci-runner/w",
			"expected": "C:\\Users\\<user>\\AppData\\x, d:\\users\\<user>\\y, /Users/<user>/z, /home/<user>/w"
		},
		{
			"id": "shared_profiles_are_kept",
			"context": {},
			"input": "C:\\Users\\Public\\Desktop and C:\\Users\\Default\\NTUSER and /Users/Shared/x and C:\\USERS\\PUBLIC",
			"expected": "C:\\Users\\Public\\Desktop and C:\\Users\\Default\\NTUSER and /Users/Shared/x and C:\\USERS\\PUBLIC"
		},
		{
			"id": "own_home_wins_over_the_foreign_rule",
			"context": { "home": "C:\\Users\\Me", "user": "Me", "case_insensitive": true },
			"input": "C:\\Users\\Me\\a and C:\\Users\\Other\\b",
			"expected": "~\\a and C:\\Users\\<user>\\b"
		},
		{
			"id": "log_line_temp_folder_of_the_account",
			"context": { "home": "C:\\Users\\Jane", "user": "Jane", "case_insensitive": true },
			"input": "2026-10-09 15:07:15:294 [INFO] [adapters.shell_runner] Removed 1 capture folder(s) that exited processes left in 'C:\\Users\\Jane\\AppData\\Local\\Temp'.",
			"expected": "2026-10-09 15:07:15:294 [INFO] [adapters.shell_runner] Removed 1 capture folder(s) that exited processes left in '~\\AppData\\Local\\Temp'."
		},
		{
			"id": "log_line_report_attachment_with_a_support_mail",
			"context": { "home": "C:\\Users\\Jane", "user": "Jane", "case_insensitive": true },
			"input": "Report from jane.smith@corp.example sent by Jane via https://api:s3cr3t-pass@proxy.corp.example:8080/ for C:\\Users\\Jane\\x and \\\\SRV\\home\\Jane",
			"expected": "Report from <email> sent by <user> via https://<secret>@proxy.corp.example:8080/ for ~\\x and \\\\SRV\\home\\<user>"
		},
		{
			"id": "log_line_other_profile_in_a_crash_path",
			"context": { "home": "C:\\Users\\Jane", "user": "Jane", "case_insensitive": true },
			"input": "[ERROR] [Updater] Cannot open C:\\Users\\svc-install\\AppData\\Local\\Ergopti\\bundle\\a.zip (copied from /home/jane-old/dl)",
			"expected": "[ERROR] [Updater] Cannot open C:\\Users\\<user>\\AppData\\Local\\Ergopti\\bundle\\a.zip (copied from /home/<user>/dl)"
		},
		{
			"id": "config_dir_masks_pack_and_file_names_after_a_quote",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "Loaded 'D:\\Work\\config\\ergopti_plus\\hotstrings\\perso_test\\cat_a\\item_1_root.toml' (12 entries)",
			"expected": "Loaded '<config>\\hotstrings\\<name>\\<name>\\<name>' (12 entries)"
		},
		{
			"id": "config_dir_keeps_the_names_the_product_ships",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "Read D:\\Work\\config\\ergopti_plus\\autohotkey\\config.toml and D:\\Work\\config\\ergopti_plus\\autohotkey\\tap_hold.toml: 136 applied",
			"expected": "Read <config>\\autohotkey\\config.toml and <config>\\autohotkey\\tap_hold.toml: 136 applied"
		},
		{
			"id": "config_dir_bare_names_may_hold_spaces_before_a_separator",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "Skipped D:\\Work\\config\\ergopti_plus\\hotstrings\\my pack\\a.toml because it is empty",
			"expected": "Skipped <config>\\hotstrings\\<name>\\<name> because it is empty"
		},
		{
			"id": "config_dir_quoted_names_may_hold_spaces_and_apostrophes",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "Parsing \"D:\\Work\\config\\ergopti_plus\\hotstrings\\Zoe's pack\\my words.toml\": ok",
			"expected": "Parsing \"<config>\\hotstrings\\<name>\\<name>\": ok"
		},
		{
			"id": "config_dir_under_home_is_found_raw_and_after_the_home_pass",
			"context": {
				"home": "/Users/jdoe",
				"user": "jdoe",
				"config_dir": "/Users/jdoe/.config/ergopti_plus",
				"case_insensitive": false
			},
			"input": "Opened /Users/jdoe/.config/ergopti_plus/hotstrings/perso/a.toml and (older line) ~/.config/ergopti_plus/hotstrings/perso/b.toml and ~/.config/ergopti_plus2/x",
			"expected": "Opened <config>/hotstrings/<name>/<name> and (older line) <config>/hotstrings/<name>/<name> and ~/.config/ergopti_plus2/x"
		},
		{
			"id": "config_dir_compares_like_the_file_system",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\Config\\Ergopti_Plus",
				"case_insensitive": true
			},
			"input": "d:\\work\\config\\ergopti_plus\\HotStrings\\Mine\\x.toml",
			"expected": "<config>\\HotStrings\\<name>\\<name>"
		},
		{
			"id": "config_dir_posix_compares_exactly",
			"context": {
				"home": "/home/jdoe",
				"user": "jdoe",
				"config_dir": "/home/jdoe/Cfg",
				"case_insensitive": false
			},
			"input": "/home/jdoe/cfg/hotstrings/p/a.toml and /home/jdoe/Cfg/hotstrings/p/a.toml",
			"expected": "~/cfg/hotstrings/p/a.toml and <config>/hotstrings/<name>/<name>"
		},
		{
			"id": "config_dir_a_shortened_path_keeps_its_known_name",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "Reading 'D:\\Work\\config\\ergopti_plus\\autohotkey\\config.toml'… and D:\\Work\\config\\ergopti_plus\\autohotkey\\config.toml… done",
			"expected": "Reading '<config>\\autohotkey\\config.toml'… and <config>\\autohotkey\\config.toml… done"
		},
		{
			"id": "config_dir_without_context_is_untouched",
			"context": {},
			"input": "D:\\Work\\config\\ergopti_plus\\hotstrings\\perso\\a.toml",
			"expected": "D:\\Work\\config\\ergopti_plus\\hotstrings\\perso\\a.toml"
		},
		{
			"id": "config_dir_prefix_lookalike_is_untouched",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "D:\\Work\\config\\ergopti_plus_old\\hotstrings\\perso",
			"expected": "D:\\Work\\config\\ergopti_plus_old\\hotstrings\\perso"
		},
		{
			"id": "config_dir_trailing_separator_in_context",
			"context": {
				"home": "/home/jdoe",
				"user": "jdoe",
				"config_dir": "/home/jdoe/cfg/",
				"case_insensitive": false
			},
			"input": "/home/jdoe/cfg/hotstrings/p/a.toml",
			"expected": "<config>/hotstrings/<name>/<name>"
		},
		{
			"id": "config_dir_non_ascii_names_are_masked_whole",
			"context": {
				"home": "C:\\Users\\Jane",
				"user": "Jane",
				"config_dir": "D:\\Work\\config\\ergopti_plus",
				"case_insensitive": true
			},
			"input": "'D:\\Work\\config\\ergopti_plus\\hotstrings\\Café Été\\mots.toml'",
			"expected": "'<config>\\hotstrings\\<name>\\<name>'"
		},
		{
			"id": "profile_folder_with_a_space_is_redacted_whole",
			"context": { "home": "C:\\Users\\Jane", "user": "Jane", "case_insensitive": true },
			"input": "C:\\Users\\John Smith\\AppData\\Local\\x and C:\\Users\\Mary Ann Lee\\Documents and \"C:\\Users\\Zoe Blue\" and C:\\Users\\Bob see D:\\x",
			"expected": "C:\\Users\\<user>\\AppData\\Local\\x and C:\\Users\\<user>\\Documents and \"C:\\Users\\<user>\" and C:\\Users\\<user> see D:\\x"
		},
		{
			"id": "profile_folder_with_non_ascii_letters_is_redacted_whole",
			"context": {},
			"input": "/home/José/notes and /Users/Zoë Müller/x",
			"expected": "/home/<user>/notes and /Users/<user>/x"
		},
		{
			"id": "profile_folder_keeps_the_sentence_that_follows",
			"context": {},
			"input": "Opened /home/jdoe2 and then closed it.",
			"expected": "Opened /home/<user> and then closed it."
		},
		{
			"id": "profile_folder_with_a_space_at_the_end_of_the_line",
			"context": {},
			"input": "profile C:\\Users\\John Smith",
			"expected": "profile C:\\Users\\<user>"
		}
	]
}
