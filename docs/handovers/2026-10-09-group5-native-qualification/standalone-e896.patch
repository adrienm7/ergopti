+				|| directoryBefore.st_ctimespec.tv_nsec != directoryAfter.st_ctimespec.tv_nsec
+				|| directoryBefore.st_ctimespec.tv_sec != directoryAfter.st_ctimespec.tv_sec)
+			XCTAssertEqual(frames.map { $0.phase }, [.armed, .observed])
