#!/usr/bin/env python3
# Launcher for the App Cloner bundle.
# Python is used instead of zsh because macOS refuses to execute a plain shell
# script as the main binary of an .app bundle (no Mach-O header).
import os
import shutil
import subprocess
import sys
import tempfile

def create_log_path():
    """Return a private per-launch directory and log path, or empty strings."""
    run_dir = ""
    try:
        run_dir = tempfile.mkdtemp(prefix="ergopti-appcloner-")
        os.chmod(run_dir, 0o700)
        return run_dir, os.path.join(run_dir, "appcloner.log")
    except OSError:
        if run_dir:
            shutil.rmtree(run_dir, ignore_errors=True)
        return "", ""

def open_log(log_path):
    """Open the owned log without following links, falling back to /dev/null."""
    if log_path:
        fd = None
        try:
            flags = os.O_WRONLY | os.O_CREAT | os.O_APPEND
            if hasattr(os, "O_NOFOLLOW"):
                flags |= os.O_NOFOLLOW
            fd = os.open(log_path, flags, 0o600)
            return os.fdopen(fd, "a", encoding="utf-8")
        except OSError:
            if fd is not None:
                os.close(fd)
    return open(os.devnull, "a", encoding="utf-8")

def ensure_icon(resources_dir, log):
    """Build AppIcon.icns from AppIcon.svg if missing or stale.

    Self-contained icon generation — App Cloner no longer depends on
    Hammerspoon's startup hook to build its own icon. Runs make_icon.sh
    when AppIcon.icns is absent OR when AppIcon.svg is newer than it.
    """
    svg  = os.path.join(resources_dir, "AppIcon.svg")
    icns = os.path.join(resources_dir, "AppIcon.icns")
    script = os.path.join(resources_dir, "make_icon.sh")
    if not os.path.exists(svg) or not os.path.exists(script):
        return
    needs_build = (
        not os.path.exists(icns)
        or os.path.getmtime(svg) > os.path.getmtime(icns)
    )
    if needs_build:
        log.write(f"[AppCloner] regenerating icon from {svg}\n")
        subprocess.run(["zsh", script], capture_output=True)

def resolve_locale() -> str:
    """Return the two-letter ISO locale code to use for the UI.

    Priority: ERGOPTI_LOCALE env var (injected by menu_apps.lua when
    available) → first two chars of LANG → 'fr' default.
    """
    loc = os.environ.get("ERGOPTI_LOCALE", "").strip()
    if loc:
        return loc
    lang = os.environ.get("LANG", "")
    if len(lang) >= 2:
        return lang[:2]
    return "fr"

def resolve_locales_dir(app_root: str) -> str:
    """Return the absolute path to the shared locales/ directory.

    Priority: ERGOPTI_LOCALES_DIR env var → path derived from the
    app bundle location (app lives inside static/ergopti_plus/macos/apps/,
    locales are at static/ergopti_plus/shared/locales/).
    """
    d = os.environ.get("ERGOPTI_LOCALES_DIR", "").strip()
    if d:
        return d
    # Climb: app_root (.app) → apps/ → macos/ → ergopti_plus/ → shared/locales/
    candidate = os.path.join(
        os.path.dirname(os.path.dirname(os.path.dirname(app_root))),
        "shared", "locales",
    )
    if os.path.isdir(candidate):
        return candidate
    return ""

def main():
    os.umask(0o077)
    script_path = os.path.realpath(__file__)
    macos_dir   = os.path.dirname(script_path)
    app_root    = os.path.dirname(os.path.dirname(macos_dir))
    resources   = os.path.join(app_root, "Contents", "Resources")
    applescript = os.path.join(resources, "ShortcutBuilder.applescript")
    log_dir, log_path = create_log_path()

    locale_code = resolve_locale()
    locales_dir = resolve_locales_dir(app_root)

    # Build env for osascript: inherit current env and ensure locale vars are set
    # so AppleScript's do shell script can read them even if open --env was not used.
    env = os.environ.copy()
    env["ERGOPTI_LOCALE"]     = locale_code
    env["ERGOPTI_LOCALES_DIR"] = locales_dir
    env["ERGOPTI_APPCLONER_LOG"] = log_path or ""

    with open_log(log_path) as log:
        log.write(f"[AppCloner] app_root={app_root}\n")
        log.write(f"[AppCloner] applescript={applescript}\n")
        log.write(f"[AppCloner] locale={locale_code} locales_dir={locales_dir}\n")
        ensure_icon(resources, log)

    result = subprocess.run(
        ["osascript", applescript, app_root],
        capture_output=True,
        text=True,
        env=env,
    )

    with open_log(log_path) as log:
        log.write(f"[AppCloner] exit={result.returncode}\n")
        if result.stdout:
            log.write(f"[AppCloner] stdout={result.stdout}\n")
        if result.stderr:
            log.write(f"[AppCloner] stderr={result.stderr}\n")

    if result.returncode not in (0, -128):
        err_text = (result.stderr or result.stdout or "Erreur inconnue.").strip()
        if log_path:
            err_text += f"\n\nLog : {log_path}"
        clean = err_text.replace("\\", "\\\\").replace('"', '\\"')
        subprocess.run([
            "osascript", "-e",
            'display dialog "App Cloner — Erreur de démarrage :\\n\\n'
            + clean
            + '" '
            'buttons {"OK"} default button 1',
        ], capture_output=True)
    elif log_dir:
        shutil.rmtree(log_dir, ignore_errors=True)

if __name__ == "__main__":
    main()
