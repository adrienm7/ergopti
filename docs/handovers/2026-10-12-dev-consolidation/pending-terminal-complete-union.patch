+							assert(ErgoptiOutput_BeginAttempt(&guarded, OWNER, &refused,
+								units, 2, &count, &attempt) == ERGOPTI_OUTPUT_DIAGNOSTIC);
+							assert(ErgoptiOutput_Cancel(&guarded, OWNER, &refused) == 0);
+						}
+						assert(ErgoptiOutput_Plan(&o, OWNER, 77, i + 1, &r,
