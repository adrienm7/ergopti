+def explicit_xi_sources(catalogue):
+    """Resolve the direct Xi dlopen root from actual xi.pc and ELF metadata."""
+    libraries = catalogue.get("libraries")
+    descriptor = libraries.get("xi") if isinstance(libraries, dict) else None
+    if (
+        not isinstance(descriptor, dict)
+        or descriptor.get("soname") != "libXi.so.6"
+        or descriptor.get("pkg_config") != "xi"
+        or descriptor.get("portable_dlopen_roots") != ["libXi.so.6"]
+    ):
+        raise RuntimeRefused("Explicit Xi staging descriptor unavailable.")
+    # xi.pc selects the actual build library directory; no incidental curl or
+    # GTK dependency, hardcoded architecture directory or SONAME fallback.
+    directory = Path(run(["pkg-config", "--variable=libdir", "xi"]).strip())
+    if not directory.is_absolute():
+        raise RuntimeRefused("Actual Xi build library directory unavailable.")
+    source = regular_source(directory / descriptor["soname"])
+    observed = run(["readelf", "--dynamic", "--", str(source)], env={**os.environ, "LC_ALL": "C"})
+    identities = re.findall(r"\(SONAME\)[^\n]*Library soname: \[([^\]\n]+)\]", observed)
+    if identities != [descriptor["soname"]]:
+        raise RuntimeRefused("Actual Xi ELF SONAME refused.")
+    return [source]
+
