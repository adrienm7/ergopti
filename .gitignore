# OS generated files
.DS_Store
Thumbs.db

# NPM and SvelteKit files
node_modules
/.svelte-kit
/package
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
/build/

# Python files
__pycache__
.venv
.env
.env.*
!.env.example

# Logs
logs/
*.log

# Build artifacts
static/drivers/autohotkey/tests/test_results.txt
static/corpus/modifie/
static/version.json
version.json

# Scratch / WIP folders (sub-agent runs, local experiments)
.locale_work/
.scratch/

# Personal configuration files
.claude/settings.local.json

# Machine-specific paths bootstrap — points at the user's config dir
# (defaults to ~/.config/ergopti_plus/). Auto-generated, never committed.
static/drivers/autohotkey/paths.toml
static/drivers/hammerspoon/paths.toml

# Forwarding stub auto-generated by EnsurePersonalShortcutsFile — its sole
# job is `#Include <user's _ConfigDir>/personal_shortcuts.ahk`, since AHK's
# parse-time #Include cannot resolve runtime _ConfigDir directly. Hidden
# under _generated/ so the auto-managed file does not clutter the source
# tree alongside the actual driver modules.
static/drivers/autohotkey/_generated/
static/drivers/hammerspoon/_generated/

# Auto-generated dashboard prefetch sidecar (per launch)
static/drivers/_shared/ui/metrics_typing/prefetch.json
static/drivers/_shared/ui/metrics_apps/prefetch.json

# Lua compiled bytecode (generated by luac, never committed)
*.luac
luac.out

# Auto-generated hotstrings file (built at runtime from TOML sources)
static/drivers/autohotkey/lib/hotstrings_generated.ahk

# Static asset bundle assembled by tools/build_static_bundle.py for the
# compiled .exe — never committed; produced fresh on every CI build.
static/drivers/autohotkey/build/

# Swift Package Manager build cache for the macOS launcher — produced fresh
# on every build_macos_app.sh run.
static/drivers/hammerspoon/launcher/.build/
static/drivers/hammerspoon/launcher/.swiftpm/
static/drivers/hammerspoon/launcher/Package.resolved

# Temps files generated by the worktree-based development flow for Claude
.claude/worktrees/

