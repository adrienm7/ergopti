* text=auto

# Force LF for shell scripts and macOS/Linux source files
*.sh text eol=lf
*.applescript text eol=lf
*.lua text eol=lf
*.py text eol=lf

# AHK v2 requires UTF-8 BOM + CRLF — enforce CRLF on all platforms so the
# encoding invariant holds whether the file is checked out on Linux CI or Windows
*.ahk text eol=crlf
