				},
				{
					"models": ["grok-4.5*", "grok-4.6*", "grok-4.7*"],
					"fields": { "reasoning_effort": "low" },
					"_source": "https://docs.x.ai/developers/model-capabilities/text/reasoning (reasoning cannot be disabled)"
				}
			]
		},
		"mistral": {
			"label": "Mistral",
			"base_url": "https://api.mistral.ai/v1",
			"default_model": "mistral-small-latest",
