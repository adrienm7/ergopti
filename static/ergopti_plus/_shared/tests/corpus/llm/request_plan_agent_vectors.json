{
	"_comment": "The agent's admission decisions replayed through _shared/lua/llm/request_plan/agent.lua by the macOS and Linux runners (_shared/lua/test/llm_request_plan_contract.lua). admit: the refusal a manual action meets first (paused, AI off, agent mode off, System 2 unusable, focus refused); auto_blocker: what stops the automatic mode's triage, in order; triage_skip: whether a sentence is worth triaging. An absent blocker or skip means the plan answers nil: nothing blocks and nothing is skipped.",
	"drivers": {
		"macos": "Replays every vector.",
		"linux": "Replays every vector.",
		"windows": "Not ported yet: the AutoHotkey agent must replay every vector."
	},
	"vectors": [
		{
			"id": "admit-open",
			"kind": "admit",
			"description": "Nothing refuses a manual action",
			"facts": {
				"paused": false,
				"ai_enabled": true,
				"mode": "action"
			},
			"expect": {
				"allowed": true
			}
		},
		{
			"id": "admit-paused-first",
			"kind": "admit",
			"description": "A pause refuses before everything",
			"facts": {
				"paused": true,
				"ai_enabled": false,
				"mode": "off",
				"system2_usable": false,
				"focus_blocked": true
			},
			"expect": {
				"allowed": false,
				"step": "paused",
				"notice": "paused"
			}
		},
		{
			"id": "admit-ai-off-before-mode",
			"kind": "admit",
			"description": "The AI switch refuses before the agent's own mode",
			"facts": {
				"paused": false,
				"ai_enabled": false,
				"mode": "off"
			},
			"expect": {
				"allowed": false,
				"step": "ai_off",
				"notice": "disabled"
			}
		},
		{
			"id": "admit-mode-off",
