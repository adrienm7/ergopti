			"operations": [
				{
					"path": ["hotstrings", "groups", "rolls"],
					"value": true
				},
				{
					"path": ["hotstrings", "modules", "rolls", "hc"],
					"value": false
				}
			],
			"expect": {
				"ok": true,
				"decoded": [
					{
						"path": ["hotstrings", "groups", "rolls"],
						"value": true
					},
					{
						"path": ["hotstrings", "modules", "rolls", "hc"],
						"value": false
					}
				]
			}
		},
