{
	"name": "svelte-static",
	"version": "3.0.0",
	"private": true,
	"scripts": {
		"predev": "node ./tools/dev/write-branch.js",
		"dev": "vite dev",
		"prebuild": "node ./tools/dev/write-branch.js",
		"build": "vite build",
		"preview": "vite preview",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write .",
		"prepare": "husky install",
		"build:manifest": "node ./tools/build/build-features-manifest.js",
		"build:menu": "node ./tools/build/build-menu-manifest.js",
		"build:domain": "node ./tools/build/build-domain.cjs",
		"codegen": "npm run build:domain",
		"gen": "node ./tools/build/gen-all.cjs",
		"gen:list": "node ./tools/build/gen-all.cjs --list",
		"gen:check": "node ./tools/test/test-features-manifest-no-drift.cjs",
		"lint:file-headers": "node ./tools/lint/audit-file-headers.cjs",
		"lint:conventions": "node ./tools/lint/lint-conventions.js --warn-only",
		"lint:conventions:strict": "node ./tools/lint/lint-conventions.js --fail-on-violations",
		"test:port-compliance": "node ./tools/test/test-port-compliance.cjs",
		"test:no-fallbacks": "node ./tools/test/test-no-fallback-literals.cjs",
		"test:kanata-defalias-parity": "node ./tools/test/test-kanata-defalias-parity.cjs",
		"test:priority-parity": "node ./tools/test/test-priority-parity.cjs",
		"test:manifest-parity": "node ./tools/test/test-manifest-parity.cjs",
		"test:llm-legacy-basic-prompt-single-source": "node ./tools/test/test-llm-legacy-basic-prompt-single-source.cjs",
		"test:keycode-data-js-parity": "node ./tools/test/test-keycode-data-js-parity.cjs",
		"test:config-schema": "node ./tools/test/test-config-schema.cjs",
		"test:locale-order": "node ./tools/test/test-locale-order-single-source.cjs",
		"test:model-hw-calc": "uv run python static/ergopti_plus/macos/data/test_generate_models_calc.py",
		"test:ahk-encoding": "node ./tools/test/test-ahk-encoding.cjs",
		"test:ahk-parse": "node ./tools/test/test-ahk-parse-coverage.cjs",
		"test:click-lock": "node ./tools/test/test-click-lock-fix.cjs",
		"test:ui-focus": "node ./tools/test/test-ui-focus-fix.cjs",
		"test:hs-integrity": "node ./tools/test/test-hammerspoon-integrity.cjs",
		"test:section-decoration": "node ./tools/test/test-section-decoration-parity.cjs",
		"test:diagnostic-ui": "node ./tools/test/test-diagnostic-ui-integrity.cjs",
		"test:manifest-equivalence": "node ./tools/test/test-manifest-equivalence.cjs",
		"test:feature-read-sites": "node ./tools/test/test-feature-read-sites.js",
		"test:architecture": "node ./tools/test/test-architecture-diagram.cjs",
		"test:dev-tool-paths": "node ./tools/test/test-dev-tool-paths.cjs",
		"test:webview-geometry-single-source": "node ./tools/test/test-webview-geometry-single-source.cjs",
		"test:doc-paths": "node ./tools/test/test-doc-paths.cjs",
		"test:no-pinned-source-reads": "node ./tools/test/test-no-pinned-source-reads.cjs",
		"test:git-mv-resilience": "node ./tools/test/test-git-mv-resilience.cjs",
		"test:max-tokens-single-source": "node ./tools/test/test-max-tokens-single-source.cjs",
		"test:temperature-single-source": "node ./tools/test/test-temperature-single-source.cjs",
		"test:ollama-port-single-source": "node ./tools/test/test-ollama-port-single-source.cjs",
		"test:linux-llm-defaults-single-source": "node ./tools/test/test-linux-llm-defaults-single-source.cjs",
		"test:i18n-fallback-path": "node ./tools/test/test-i18n-fallback-path.cjs",
		"test:i18n-cascade": "node ./tools/test/test-webview-i18n-cascade.cjs",
		"test:drift-guard-coverage": "node ./tools/test/test-drift-guard-covers-every-output.cjs",
		"test:corpus-backspace-semantics": "node ./tools/test/test-corpus-backspace-count-semantics.cjs",
		"test:logger-scalars": "node ./tools/test/test-logger-scalars-single-source.cjs",
		"test:locale-names": "node ./tools/test/test-locale-names-single-source.cjs",
		"test:new-driver": "node ./tools/test/test-new-driver-scaffold.cjs",
		"test:tree-parity": "node ./tools/test/test-driver-tree-parity.cjs",
		"test:stub-interception": "node ./tools/test/test-stubs-intercept-something.cjs",
		"test:tap-hold-lifecycle": "node ./tools/test/test-tap-hold-defaults-lifecycle.cjs",
		"test:linux-version-single-source": "node ./tools/test/test-linux-version-single-source.cjs",
		"test:hotstring-buffer-cap-parity": "node ./tools/test/test-hotstring-buffer-cap-parity.cjs",
		"test:macos-bundle-layout": "node ./tools/test/test-macos-bundle-layout.cjs",
		"test:hs-editor-confirm": "node ./tools/test/test-hotstring-editor-confirm-wiring.cjs",
		"test:webview-teardown": "node ./tools/test/test-webview-teardown-order.cjs",
		"test:dynamic-hs-labels": "node ./tools/test/test-dynamic-hotstrings-menu-labels.cjs",
		"test:hs-config-bridge": "node ./tools/test/test-hotstrings-config-window-bridge.cjs",
		"test:prompt-editor-bridge": "node ./tools/test/test-prompt-editor-bridge.cjs",
		"test:action-picker-bridge": "node ./tools/test/test-action-picker-bridge.cjs",
		"test:js": "node ./tools/test/run-js-suite.cjs",
		"verify": "node ./tools/test/verify-change.cjs",
		"test:hs": "cd static/ergopti_plus/macos && lua tests/run.lua",
		"test:hs:e2e": "cd static/ergopti_plus/macos && lua tests/e2e/run_e2e.lua",
		"test:linux": "cd static/ergopti_plus/linux && bash -c 'if command -v luajit >/dev/null 2>&1; then luajit tests/run.lua; elif command -v lua5.4 >/dev/null 2>&1; then lua5.4 tests/run.lua; elif command -v lua >/dev/null 2>&1; then lua tests/run.lua; else echo \"No Lua runtime found\" >&2; exit 1; fi' --",
		"test:linux:e2e": "cd static/ergopti_plus/linux && bash -c 'if command -v luajit >/dev/null 2>&1; then luajit tests/e2e/run_e2e.lua; elif command -v lua5.4 >/dev/null 2>&1; then lua5.4 tests/e2e/run_e2e.lua; elif command -v lua >/dev/null 2>&1; then lua tests/e2e/run_e2e.lua; else echo \"No Lua runtime found\" >&2; exit 1; fi' --",
		"build:linux": "bash tools/build/build-linux-driver.sh --skip-smoke",
		"test:properties": "node ./tools/test/test-properties.cjs",
		"fix:banners": "node ./tools/lint/lint-conventions.js --fix-banners --warn-only",
		"fix:spacing": "node ./tools/lint/lint-conventions.js --fix-spacing --warn-only",
		"fix:unbalanced": "node ./tools/lint/lint-conventions.js --fix-unbalanced --warn-only",
		"fix:all": "node ./tools/lint/lint-conventions.js --fix-banners --fix-unbalanced --fix-spacing --warn-only",
		"install:hammerspoon": "bash ./tools/dev/install-hammerspoon.sh",
		"sync:ahk": "node ./tools/dev/sync-private-ahk.js && node ./tools/dev/remove_ahk_personal_configuration.js",
		"watch:ahk": "node ./tools/dev/watch-ahk.js",
		"watch:ahk:install": "node ./tools/dev/install-ahk-watcher.js",
		"watch:ahk:uninstall": "node ./tools/dev/uninstall-ahk-watcher.js",
		"gen:diagram": "node ./tools/codegen/gen-architecture-diagram.cjs",
		"new:driver": "node ./tools/codegen/new-driver.js",
		"bench:hotstring": "node ./tools/build/bench-hotstring.cjs",
		"codegen:terminators": "node ./tools/codegen/codegen-terminators.cjs",
		"codegen:prompt-builder:ahk": "node ./tools/codegen/codegen-prompt-builder-ahk.cjs",
		"codegen:contracts": "node ./tools/codegen/codegen-contracts-json.cjs",
		"codegen:llm-profiles-data:ahk": "node ./tools/codegen/codegen-llm-profiles-data-ahk.cjs",
		"codegen:logger-sub-files": "node ./tools/codegen/codegen-logger-sub-files.cjs",
		"codegen:locale-tables": "node ./tools/codegen/codegen-locale-tables.cjs",
		"codegen:keycode-data:js": "node ./tools/codegen/codegen-keycode-data-js.cjs",
		"test:mutation": "stryker run",
		"fix:pinned-reads": "node ./tools/lint/fix-pinned-source-reads.cjs --fix",
		"lint:pinned-reads": "node ./tools/lint/fix-pinned-source-reads.cjs --all"
	},
	"type": "module",
	"dependencies": {
		"aos": "^3.0.0-beta.6",
		"modern-normalize": "^3.0.1",
		"tocbot": "^4.30.0"
	},
	"devDependencies": {
		"@samkirkland/ftp-deploy": "^1.2.4",
		"@stryker-mutator/core": "^9.6.1",
		"@sveltejs/adapter-auto": "^6.1.0",
		"@sveltejs/adapter-static": "^3.0.9",
		"@sveltejs/enhanced-img": "^0.8.1",
		"@sveltejs/kit": "^2.53.4",
		"@types/aos": "^3.0.7",
		"fast-check": "^4.8.0",
		"husky": "^8.0.0",
		"lint-staged": "^16.1.5",
		"pm2": "^5.4.3",
		"prettier": "^3.6.2",
		"prettier-plugin-css-order": "^2.1.2",
		"prettier-plugin-svelte": "^3.4.0",
		"smol-toml": "^1.3.0",
		"svelte": "^5.53.7",
		"vite": "^7.2.2"
	}
}
