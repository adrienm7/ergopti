{
	"contract": "versioned executable and literal argv; target availability is native and separate",
	"cases": [
		{
			"id": "posix-empty",
			"syntaxes": ["posix"],
			"value": "{\"version\":1,\"executable\":\"/tmp/program\",\"arguments\":[]}",
			"expected": {
				"executable": "/tmp/program",
				"arguments": []
			}
		},
		{
			"id": "literal-argv",
			"syntaxes": ["posix"],
			"value": "{\"version\":1,\"executable\":\"/tmp/été program\",\"arguments\":[\"\",\"two words\",\"日本語\",\"\\\"quoted\\\"\",\"\\\\tail\\\\\",\"$(touch ignored); %TOKEN%\",\"line\\nnext\"]}",
			"expected": {
				"executable": "/tmp/été program",
				"arguments": [
					"",
					"two words",
					"日本語",
					"\"quoted\"",
					"\\tail\\",
					"$(touch ignored); %TOKEN%",
					"line\nnext"
				]
			}
		},
		{
			"id": "windows-literal",
			"syntaxes": ["windows"],
			"value": "{\"version\":1,\"executable\":\"C:\\\\Program Files\\\\été\\\\program.exe\",\"arguments\":[\"\",\"two words\",\"日本語\",\"\\\"quote\\\"\",\"trail\\\\\",\"%TOKEN%\",\"a&b\"]}",
			"expected": {
				"executable": "C:\\Program Files\\été\\program.exe",
				"arguments": ["", "two words", "日本語", "\"quote\"", "trail\\", "%TOKEN%", "a&b"]
			}
		},
		{
			"id": "unc-file",
			"syntaxes": ["windows"],
			"value": "{\"version\":1,\"executable\":\"\\\\\\\\server\\\\share\\\\program.exe\",\"arguments\":[]}",
			"expected": {
				"executable": "\\\\server\\share\\program.exe",
				"arguments": []
			}
		},
		{
			"id": "null",
			"syntaxes": ["windows", "posix"],
			"value": "null",
			"expected": null
		},
		{
			"id": "empty-object",
			"syntaxes": ["windows", "posix"],
			"value": "{}",
			"expected": null
		},
		{
			"id": "array",
			"syntaxes": ["windows", "posix"],
			"value": "[]",
			"expected": null
		},
		{
			"id": "version-two",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":2,\"executable\":\"/bin/true\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "version-bool",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":true,\"executable\":\"/bin/true\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "version-text",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":\"1\",\"executable\":\"/bin/true\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "args-object",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":{}}",
			"expected": null
		},
		{
			"id": "args-null",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":null}",
			"expected": null
		},
		{
			"id": "argument-number",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[2]}",
			"expected": null
		},
		{
			"id": "argument-null",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[null]}",
			"expected": null
		},
		{
			"id": "argument-object",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[{}]}",
			"expected": null
		},
		{
			"id": "duplicate-executable",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/false\",\"executable\":\"/bin/true\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "duplicate-escaped-key",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"argum\\u0065nts\":[],\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "extra-field",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[],\"shell\":true}",
			"expected": null
		},
		{
			"id": "missing-arguments",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\"}",
			"expected": null
		},
		{
			"id": "relative-executable",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"program\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "nul-executable",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/tmp/a\\u0000b\",\"arguments\":[]}",
			"expected": null
		},
		{
			"id": "nul-argument",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[\"a\\u0000b\"]}",
			"expected": null
		},
		{
			"id": "invalid-surrogate",
			"syntaxes": ["windows", "posix"],
			"value": "{\"version\":1,\"executable\":\"/bin/true\",\"arguments\":[\"\\ud800\"]}",
			"expected": null
		}
	]
}
