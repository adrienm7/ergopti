+			find_release = function(tag) call("find"); return { tag = tag } end,
+			backup = function() call("backup"); return { path = "/private/backup" } end,
+			resolve_asset = function() call("asset"); return { digest = "independently-pinned" } end,
+			download = function(_, _, done) call("download"); state.callbacks[#state.callbacks + 1] = done; return true end,
+			install = function() call("install"); return true end,
+			restart = function() call("restart"); return true end,
+			report = function(message) state.reports[#state.reports + 1] = message end,
+			failure_contract = function() return contract end,
+			failure_owner = function() return native end,
+			failure_current = function(owner)
+				if state.on_current then state.on_current() end
