* text=auto

# Force LF for shell scripts and macOS/Linux source files
*.sh text eol=lf
*.applescript text eol=lf
*.lua text eol=lf
*.py text eol=lf

# AHK v2 source uses UTF-8 BOM + LF. Keep the parser invariant identical on
# Windows and Linux CI, and reject mixed line endings in the encoding gate.
*.ahk text eol=lf
