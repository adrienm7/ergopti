{
  "_comment": "Logger test vectors — shared by AHK and Hammerspoon test suites.",
  "_sentinel": "TIMESTAMP replaces the real timestamp so vectors are time-independent.",
  "_format": "Each vector: variant, module, message (format string), args (array), expected (rendered line with TIMESTAMP sentinel).",

  "vectors": [

    {
      "id": "debug_basic",
      "description": "DEBUG variant: basic message, no format args.",
      "variant": "debug",
      "module": "TestModule",
      "message": "Cache miss — reloading.",
      "args": [],
      "expected": "TIMESTAMP [DEBUG] [TestModule] Cache miss — reloading."
    },

    {
      "id": "trace_basic",
      "description": "TRACE variant: in-progress message ends with ellipsis.",
      "variant": "trace",
      "module": "TestModule",
      "message": "Timer started (0.300s)…",
      "args": [],
      "expected": "TIMESTAMP [TRACE] [TestModule] Timer started (0.300s)…"
    },

    {
      "id": "done_basic",
      "description": "DONE variant: completion message ends with full stop.",
      "variant": "done",
      "module": "TestModule",
      "message": "Timer stopped.",
      "args": [],
      "expected": "TIMESTAMP [DONE] [TestModule] Timer stopped."
    },

    {
      "id": "info_basic",
      "description": "INFO variant: general status message.",
      "variant": "info",
      "module": "TapHoldLoader",
      "message": "Config file located.",
      "args": [],
      "expected": "TIMESTAMP [INFO] [TapHoldLoader] Config file located."
    },

    {
      "id": "start_basic",
      "description": "START variant: operation start ends with ellipsis.",
      "variant": "start",
      "module": "TapHoldLoader",
      "message": "Loading tap-hold config from '/path/to/tap_hold.toml'…",
      "args": [],
      "expected": "TIMESTAMP [START] [TapHoldLoader] Loading tap-hold config from '/path/to/tap_hold.toml'…"
    },

    {
      "id": "success_basic",
      "description": "SUCCESS variant: operation end ends with full stop.",
      "variant": "success",
      "module": "TapHoldLoader",
      "message": "Tap-hold config loaded (8 key(s), 2 layer(s)).",
      "args": [],
      "expected": "TIMESTAMP [SUCCESS] [TapHoldLoader] Tap-hold config loaded (8 key(s), 2 layer(s))."
    },

    {
      "id": "warn_basic",
      "description": "WARN variant emits [WARNING] label (not [WARN]).",
      "variant": "warn",
      "module": "gestures",
      "message": "Probe timed out — retry 1/3.",
      "args": [],
      "expected": "TIMESTAMP [WARNING] [gestures] Probe timed out — retry 1/3."
    },

    {
      "id": "error_basic",
      "description": "ERROR variant: unrecoverable failure.",
      "variant": "error",
      "module": "karabiner",
      "message": "Config write failed: permission denied.",
      "args": [],
      "expected": "TIMESTAMP [ERROR] [karabiner] Config write failed: permission denied."
    },

    {
      "id": "format_string_integer",
      "description": "Format args: one integer substituted into the message.",
      "variant": "info",
      "module": "TapHoldLoader",
      "message_ahk": "Loaded {1} key(s).",
      "message_hs":  "Loaded %d key(s).",
      "args": [8],
      "expected": "TIMESTAMP [INFO] [TapHoldLoader] Loaded 8 key(s)."
    },

    {
      "id": "format_string_two_integers",
      "description": "Format args: two integers substituted.",
      "variant": "success",
      "module": "TapHoldLoader",
      "message_ahk": "Tap-hold config loaded ({1} key(s), {2} layer(s)).",
      "message_hs":  "Tap-hold config loaded (%d key(s), %d layer(s)).",
      "args": [8, 2],
      "expected": "TIMESTAMP [SUCCESS] [TapHoldLoader] Tap-hold config loaded (8 key(s), 2 layer(s))."
    },

    {
      "id": "format_string_one_string",
      "description": "Format args: one string substituted.",
      "variant": "debug",
      "module": "ModelSwitcher",
      "message_ahk": "Backend resolved to '{1}'.",
      "message_hs":  "Backend resolved to '%s'.",
      "args": ["mlx"],
      "expected": "TIMESTAMP [DEBUG] [ModelSwitcher] Backend resolved to 'mlx'."
    },

    {
      "id": "format_string_string_and_integer",
      "description": "Format args: string then integer.",
      "variant": "info",
      "module": "menu_llm",
      "message_ahk": "Profile '{1}' selected (power level {2}).",
      "message_hs":  "Profile '%s' selected (power level %d).",
      "args": ["advanced", 2],
      "expected": "TIMESTAMP [INFO] [menu_llm] Profile 'advanced' selected (power level 2)."
    },

    {
      "id": "module_tag_with_dots",
      "description": "Module tag containing dots is wrapped verbatim.",
      "variant": "debug",
      "module": "keymap.llm_bridge",
      "message": "Stale callback discarded.",
      "args": [],
      "expected": "TIMESTAMP [DEBUG] [keymap.llm_bridge] Stale callback discarded."
    },

    {
      "id": "module_tag_with_underscores",
      "description": "Module tag containing underscores is wrapped verbatim.",
      "variant": "info",
      "module": "menu_llm.model_switcher",
      "message": "Model switched.",
      "args": [],
      "expected": "TIMESTAMP [INFO] [menu_llm.model_switcher] Model switched."
    },

    {
      "id": "level_label_warning_spelling",
      "description": "The warn() call emits [WARNING] not [WARN] — critical for sub-file routing.",
      "variant": "warn",
      "module": "AnyModule",
      "message": "Something unexpected happened.",
      "args": [],
      "expected": "TIMESTAMP [WARNING] [AnyModule] Something unexpected happened."
    },

    {
      "id": "empty_args_no_substitution",
      "description": "A message with no format args is emitted verbatim (no placeholder expansion).",
      "variant": "info",
      "module": "FirstBoot",
      "message": "User config already present — skipping bootstrap.",
      "args": [],
      "expected": "TIMESTAMP [INFO] [FirstBoot] User config already present — skipping bootstrap."
    },

    {
      "id": "float_arg",
      "description": "Format args: float substituted.",
      "variant": "debug",
      "module": "TapHoldLoader",
      "message_ahk": "Threshold set to {1:.2f}s.",
      "message_hs":  "Threshold set to %.2fs.",
      "args": [0.35],
      "expected_ahk": "TIMESTAMP [DEBUG] [TapHoldLoader] Threshold set to 0.35s.",
      "expected_hs":  "TIMESTAMP [DEBUG] [TapHoldLoader] Threshold set to 0.35s."
    }
  ]
}
