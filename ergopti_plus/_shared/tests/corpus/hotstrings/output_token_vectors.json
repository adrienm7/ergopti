{
	"description": "The grammar of a hotstring output, read the same way by the three drivers: _shared/lua/send_input (parse_output) on macOS and Linux, windows/infra/send_input_parameter.ahk (SendInputParseOutput) on Windows.",
	"rule": "{name} presses a key of _shared/modules/actions/send_keys.json, by id or alias, in any case. {name N} presses it N times, N from 1 to output_key_max_repeat with no leading zero. {U+XXXX} types that code point, from 1 to 6 hex digits; a surrogate, a value above 10FFFF or a control character is not a code point here. {{} types a left brace and {}} a right brace, which is how a literal {Left} is written: {{}Left}. A line break (CRLF, CR or LF) is the enter key and a tab is the tab key. Everything else is literal text: an unknown {group}, an unmatched brace, and + ^ ! # ~ which have no meaning here. An output with a key token leaves the caret somewhere the engine cannot read, so each driver forgets its typing buffer and the AI context after it, and such an output takes no part in a cascade.",
	"vectors": [
		{
			"id": "plain-text",
			"output": "bonjour",
			"tokens": [{ "text": "bonjour" }],
			"text": "bonjour",
			"has_keys": false
		},
		{ "id": "empty", "output": "", "tokens": [], "text": "", "has_keys": false },
		{
			"id": "report-left-after-text",
			"output": "(){left}",
			"tokens": [{ "text": "()" }, { "key": "left", "count": 1 }],
			"text": "()",
			"has_keys": true
		},
		{
			"id": "left-capitalised",
			"output": "ab{Left}",
			"tokens": [{ "text": "ab" }, { "key": "left", "count": 1 }],
			"text": "ab",
			"has_keys": true
		},
		{
			"id": "left-uppercase",
			"output": "ab{LEFT}",
			"tokens": [{ "text": "ab" }, { "key": "left", "count": 1 }],
			"text": "ab",
			"has_keys": true
		},
		{
			"id": "left-mixed-case",
			"output": "ab{lEfT}",
			"tokens": [{ "text": "ab" }, { "key": "left", "count": 1 }],
			"text": "ab",
			"has_keys": true
		},
		{
			"id": "right",
			"output": "{right}",
			"tokens": [{ "key": "right", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "up",
			"output": "{up}",
			"tokens": [{ "key": "up", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "down",
			"output": "{down}",
			"tokens": [{ "key": "down", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "home",
			"output": "{home}",
			"tokens": [{ "key": "home", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "end",
			"output": "{end}",
			"tokens": [{ "key": "end", "count": 1 }],
			"text": "",
			"has_keys": true
		},
		{
			"id": "enter",
			"output": "a{enter}b",
			"tokens": [{ "text": "a" }, { "key": "enter", "count": 1 }, { "text": "b" }],
			"text": "ab",
			"has_keys": true
		},
		{
			"id": "return-is-enter",
			"output": "{Return}",
			"tokens": [{ "key": "enter", "count": 1 }],
			"text": "",
			"has_keys": true
