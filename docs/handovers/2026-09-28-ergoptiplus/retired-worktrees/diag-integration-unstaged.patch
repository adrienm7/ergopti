 		override_path = override_path,
 		toml_resolver = function(category)
+			if extension_paths[category] then return extension_paths[category] end
 			if category == "personal" then
 				return config_paths.get("PersonalTomlPath")
 			end
@@ -1542,6 +1553,11 @@ for _, g in ipairs(require("infra.personal_hotstrings").load({ bundled_hotstring
 	hotfile_paths[g.name] = g.path
 end
 
