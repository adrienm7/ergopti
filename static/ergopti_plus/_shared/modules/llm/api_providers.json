	"test_request": {
		"_comment": "Minimal end-to-end probe both drivers send verbatim for the Test-API action: tiny fixed prompt, deterministic sampling, small completion budget. Change it here, never per driver.",
		"system_prompt": "You are a connectivity probe. Reply with exactly: OK",
		"user_text": "ping",
		"temperature": 0,
		"max_tokens": 16
	},
	"decisions_test": {
		"_comment": "Minimal probe the Test-API action sends to a decisions provider, verbatim: one yes/no question about a fixed state.",
		"state": "ping",
		"questions": { "ok": { "type": "noul", "instructions": "The state is the word ping." } }
	},
