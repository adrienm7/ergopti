+-- Discover once for this boot so the loader, override resolver and menu paths
+-- all refer to the same committed extension generation.
+local extension_packs = require("infra.extension_packs").scan()
+local extension_paths = {}
+for _, pack in ipairs(extension_packs) do
+	for _, file in ipairs(pack.toml_files) do
+		extension_paths[require("hotstrings.extensions").category_key(pack.id, file.stem)] = file.path
+	end
+end
+
