{
	"name": "@ergopti/hotstrings-web",
	"version": "0.1.0",
	"description": "Dependency-free hotstring engine faithful to Ergopti's hotstring semantics, for the browser",
	"license": "MIT",
	"private": true,
	"type": "module",
	"exports": {
		".": "./src/index.ts",
		"./HotstringEditor.svelte": {
			"svelte": "./src/HotstringEditor.svelte",
			"default": "./src/HotstringEditor.svelte"
		}
	},
	"files": [
		"src",
		"README.md",
		"LICENSE"
	],
	"sideEffects": false,
	"scripts": {
		"test": "vitest run",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit"
	},
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"peerDependenciesMeta": {
		"svelte": {
			"optional": true
		}
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@types/node": "^22.20.7",
		"@vitest/coverage-v8": "^5.1.2",
		"jsdom": "^27.4.0",
		"svelte": "^5.59.2",
		"typescript": "^5.9.3",
		"vite": "^8.4.0",
		"vitest": "^5.1.2"
	}
}
