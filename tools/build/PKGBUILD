# Maintainer: Ergopti Contributors <ergopti@example.com>
# Contributor: Auto-generated by build-linux-rpm.sh / PKGBUILD template
#
# Build with:  makepkg -si
# Or install from AUR: yay -S ergopti

pkgname=ergopti
pkgver=__VERSION__
pkgrel=1
pkgdesc="Ergonomic keyboard optimizer with AI-powered hotstrings"
arch=('any')
url="https://github.com/adrienm7/ergopti"
license=('MIT')
depends=('luajit' 'ydotool' 'xdotool' 'xclip' 'libnotify' 'curl')
optdepends=('lua-luv: async I/O for timers and HTTP'
            'lua-filesystem: faster file discovery'
            'openssl: SHA-256 hashing for metrics privacy'
            'yad: tray icon and tooltip support'
            'kanata: advanced keyboard remapping')
makedepends=('git' 'nodejs' 'lua')
source=("ergopti::git+https://github.com/adrienm7/ergopti.git#branch=dev")
sha256sums=('SKIP')

package() {
  cd "$srcdir/ergopti"

  # Build the driver bundle
  bash tools/build/build-linux-driver.sh --skip-smoke

  # Install driver files
  install -d "$pkgdir/usr/lib/ergopti"
  cp -r build/linux/*.lua "$pkgdir/usr/lib/ergopti/" 2>/dev/null || true
  cp -r build/linux/modules "$pkgdir/usr/lib/ergopti/" 2>/dev/null || true
  cp -r build/linux/adapters "$pkgdir/usr/lib/ergopti/" 2>/dev/null || true
  cp -r build/linux/ui "$pkgdir/usr/lib/ergopti/" 2>/dev/null || true
  cp -r build/linux/vendor "$pkgdir/usr/lib/ergopti/" 2>/dev/null || true

  if [ -d "static/ergopti_plus/_shared/lua" ]; then
    install -d "$pkgdir/usr/lib/ergopti/_shared"
    cp -r static/ergopti_plus/_shared/lua "$pkgdir/usr/lib/ergopti/_shared/"
  fi

  # Wrapper script
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/ergopti" << 'WRAPPER'
#!/bin/bash
exec luajit /usr/lib/ergopti/ergopti_hotstrings.lua "$@"
WRAPPER
  chmod 755 "$pkgdir/usr/bin/ergopti"

  # Desktop entry
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/ergopti.desktop" << 'DESKTOP'
[Desktop Entry]
Type=Application
Name=Ergopti
Comment=Ergonomic keyboard optimizer — hotstring engine + metrics
Exec=ergopti
Icon=ergopti
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
DESKTOP

  # Icon placeholder
  install -Dm644 /dev/stdin "$pkgdir/usr/share/icons/hicolor/128x128/apps/ergopti.png" << 'ICON'
ICON
  # (Empty placeholder — replace with actual icon before publishing to AUR)

  # Default config
  install -d "$pkgdir/etc/ergopti"
  cat > "$pkgdir/etc/ergopti/config.toml" << 'CONFIG'
[general]
language = "fr"
driver   = "linux"

[llm]
port = 11434
model = "codellama"

[hotstrings]
enabled = true
CONFIG

  # systemd user service
  install -Dm644 /dev/stdin "$pkgdir/usr/lib/systemd/user/ergopti.service" << 'SERVICE'
[Unit]
Description=Ergopti — ergonomic keyboard optimizer
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/ergopti --tray
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
SERVICE

  # Post-install message
  install -d "$pkgdir/usr/share/doc/ergopti"
  cat > "$pkgdir/usr/share/doc/ergopti/README.install" << 'DOC'
Post-installation steps:
  1. Enable and start the user service:
       systemctl --user enable ergopti.service
       systemctl --user start ergopti.service

  2. Configure hotstrings in ~/.config/ergopti/hotstrings/

  3. For LLM features, start Ollama:
       ollama serve

  4. For tray icon and tooltips, install yad:
       sudo pacman -S yad

  5. For advanced keyboard remapping, install kanata:
       sudo pacman -S kanata
DOC
}
