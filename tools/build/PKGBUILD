# Maintainer: Ergopti Contributors <ergopti@example.com>
#
# The release's own Arch recipe: a repack of the release tarball, which carries
# the driver and the private runtime the AppImage stages on the oldest
# supported LTS (LuaJIT, luv, luafilesystem, luaposix, curl, sqlite3, openssl,
# zstd). Nothing is built here and no host interpreter runs the daemon (owned
# runtimes, PIN). This file is a template: tools/build/render-arch-pkgbuild.cjs
# fills its version, tag and checksum placeholders from the tarball a release
# ships, and the release attaches the rendered PKGBUILD with ergopti.install.
#
# Build with:  makepkg -si   (in a folder holding PKGBUILD and ergopti.install)

pkgname=ergopti
pkgver=__PKGVER__
pkgrel=1
pkgdesc="Ergonomic keyboard optimizer with AI-powered hotstrings"
# The private runtime is x86_64 ELF, staged in the oldest-LTS build container.
arch=('x86_64')
url="https://github.com/adrienm7/ergopti"
license=('MIT')
install=ergopti.install
# The tarball's private runtime was staged and admitted as it is: keep its
# ELF files byte for byte, with no debug split package.
options=('!strip' '!debug')
backup=('etc/udev/rules.d/99-ergopti-uinput.rules' 'etc/modules-load.d/ergopti-uinput.conf')
# BEGIN GENERATED LINUX NATIVE REQUIREMENTS
depends=('xclip' 'libnotify' 'libxkbcommon' 'at-spi2-core' 'xdg-utils' 'polkit' 'kmod' 'systemd' 'shadow' 'util-linux' 'glibc' 'libayatana-appindicator' 'lua51-lgi' 'webkit2gtk-4.1' 'libsecret' 'libxkbcommon-x11' 'libx11')
# END GENERATED LINUX NATIVE REQUIREMENTS
optdepends=('xdotool: focused-window identity on X11'
            'wmctrl: window list of the excluded-applications picker on X11'
            'wl-clipboard: clipboard fallback on Wayland')
# The release asset keeps one name across releases; the local name carries the
# version so makepkg's source cache never mixes two releases.
source=("ergopti-plus-linux-${pkgver}.tar.gz::https://github.com/adrienm7/ergopti/releases/download/__TAG__/ergopti-plus-linux.tar.gz")
sha256sums=('__SHA256__')

package() {
  # makepkg extracts the tarball into $srcdir: linux/ (the driver, its private
  # runtime and network-runtime-env.sh), _shared/, bin/ and install.sh.
  local bundle="${ERGOPTI_ARCH_BUNDLE_DIR:-$srcdir}"

  # The driver tree, its private runtime prefix (runtime/) and the environment
  # that roots the daemon on it (network-runtime-env.sh). A copy that fails
  # fails the package: a silent one shipped a package with no driver once.
  install -d "$pkgdir/usr/lib/ergopti"
  cp -r "$bundle/linux/." "$pkgdir/usr/lib/ergopti/"
  rm -rf "$pkgdir/usr/lib/ergopti/tests" "$pkgdir/usr/lib/ergopti/__pycache__"

  # The shared tree is a SIBLING of the driver modules at runtime, and the
  # daemon resolves it that way: the keycode tables, the hotstring packs, the
  # locales and the defaults the resolver fails fast on all live there.
  install -d "$pkgdir/usr/lib/ergopti/_shared"
  cp -r "$bundle/_shared/." "$pkgdir/usr/lib/ergopti/_shared/"

  # The tarball's build stamp is how the installed daemon names its commit
  # (tools/build/write_build_stamp.sh wrote it before the tarball was packed);
  # a package without it would report "unknown".
  grep -Eq '^commit=[0-9a-f]{40}$' "$pkgdir/usr/lib/ergopti/_shared/build_stamp.txt" || {
    echo "ergopti: the release tarball carries no build stamp commit" >&2
    return 1
  }

  # The wrapper. The package's private runtime decides LUA_PATH, LUA_CPATH and
  # the programs the driver runs (network-runtime-env.sh, shared with the
  # AppImage, the .deb and the .rpm), and refuses a missing part.
  install -d "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/ergopti" << 'WRAPPER'
#!/bin/bash
set -euo pipefail
DRIVER_ROOT="/usr/lib/ergopti"
source "$DRIVER_ROOT/network-runtime-env.sh" "$DRIVER_ROOT/runtime" "$DRIVER_ROOT"
exec bash "$DRIVER_ROOT/install/launch.sh" "$@"
WRAPPER
  chmod 755 "$pkgdir/usr/bin/ergopti"

  # Desktop entry
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/ergopti.desktop" << 'DESKTOP'
[Desktop Entry]
Type=Application
Name=Ergopti
Comment=Ergonomic keyboard optimizer — hotstring engine + metrics
Exec=ergopti --tray
Icon=ergopti
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
DESKTOP

  # Permission files belong to the package manager; lifecycle hooks apply them
  # and enroll graphical users through the existing privileged owner.
  install -Dm644 "$bundle/linux/install/99-ergopti-uinput.rules" \
    "$pkgdir/etc/udev/rules.d/99-ergopti-uinput.rules"
  install -Dm644 "$bundle/linux/install/ergopti-uinput.conf" \
    "$pkgdir/etc/modules-load.d/ergopti-uinput.conf"

  # The desktop uses the same packaged logo as the tray, at its real size.
  install -Dm644 "$bundle/_shared/tray/data/ergopti_tray.png" \
    "$pkgdir/usr/share/icons/hicolor/512x512/apps/ergopti.png"

  # The canonical unit prevents a refused setup from looping the prompt.
  install -d "$pkgdir/usr/lib/systemd/user"
  sed 's|^ExecStart=.*|ExecStart=/usr/bin/ergopti --service --tray|' \
    "$bundle/linux/ergopti-hotstrings.service" \
    > "$pkgdir/usr/lib/systemd/user/ergopti-hotstrings.service"
}
