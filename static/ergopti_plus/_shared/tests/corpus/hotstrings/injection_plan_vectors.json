			}
		},
		{
			"id": "cascade-terminator-widens-the-erase",
			"input": {
				"path": "terminator",
				"trigger_len": 2,
				"event_len": 1,
				"event_on_screen": false,
				"replacement": "cab",
				"terminator": " ",
				"consume_terminator": false,
				"cascade": { "replacement": "cZ", "trigger_len": 3, "tail": " ", "final_result": false }
			},
			"expect": {
				"erase": 3,
				"text": "cZ",
				"tail": " ",
				"replay": { "kind": "text", "chars": " " },
				"buffer_suffix": "cZ ",
				"final_result": false
			}
