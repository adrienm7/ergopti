{
	"Debian: installed archive": {
		"id": "distro-debian",
		"kind": "install",
		"distro": "debian",
		"container": "debian:stable-slim",
		"image": "debian:stable-slim",
		"prep": "apt-get update && apt-get install -y --no-install-recommends bash coreutils findutils grep sed sudo passwd ca-certificates git gcc libc6-dev linux-libc-dev"
	},
	"Fedora: installed archive": {
		"id": "distro-fedora",
		"kind": "install",
		"distro": "fedora",
		"container": "fedora:latest",
		"image": "fedora:latest",
		"prep": "dnf install -y bash coreutils findutils grep sed sudo shadow-utils git gcc glibc-devel kernel-headers"
	},
	"Arch Linux: installed archive": {
		"id": "distro-arch",
		"kind": "install",
		"distro": "arch",
		"container": "archlinux:latest",
		"image": "archlinux:latest",
		"prep": "pacman -Sy --noconfirm bash coreutils findutils grep sed sudo shadow git gcc glibc linux-api-headers"
	},
	"Alpine: installed archive": {
		"id": "distro-alpine",
		"kind": "install",
		"distro": "alpine",
		"container": "alpine:latest",
		"image": "alpine:latest",
		"prep": "apk add --no-cache bash coreutils findutils grep sed sudo git gcc musl-dev linux-headers"
	},
	"openSUSE: installed archive": {
		"id": "distro-opensuse",
		"kind": "install",
		"distro": "opensuse",
		"container": "opensuse/tumbleweed:latest",
		"image": "opensuse/tumbleweed:latest",
		"prep": "sed -i 's|http://download.opensuse.org|https://downloadcontent.opensuse.org|g' /etc/zypp/repos.d/*.repo && zypper --non-interactive install bash coreutils findutils grep sed sudo shadow git gcc glibc-devel linux-glibc-devel"
	},
	"Ubuntu 22.04: first installation": {
		"id": "first-install-ubuntu-22.04",
		"kind": "first",
		"distro": "ubuntu-22.04",
		"container": "",
		"image": "ubuntu:22.04"
	},
