# ===============================================
# ===============================================
# ======= 3/ Auto-generated runtime files =======
# ===============================================
# ===============================================

# Machine-specific config-dir bootstrap, written at first launch
static/ergopti_plus/windows/_generated/paths.toml
static/ergopti_plus/macos/_generated/paths.toml

# Forwarding stub written at runtime by EnsurePersonalShortcutsFile
static/ergopti_plus/windows/_generated/personal_shortcuts.ahk

# Dashboard prefetch sidecars, regenerated on every launch
static/ergopti_plus/windows/_generated/prefetch_metrics_typing.json
static/ergopti_plus/windows/_generated/prefetch_metrics_apps.json

# Corpus working copy produced by build scripts
static/corpus/modifie/




