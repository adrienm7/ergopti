{
	"$schema": "https://ergopti.com/schema/corpus/hotstrings.v1.json",
	"description": "Cross-driver hotstring cascade vectors (cascade_max_arrows, end-character parity). Each vector registers the rules, types the characters of `typed` (auto rules fire on their last character), then the optional `end_char` as a word delimiter whose consumed choice is `end_char_consumed`, and expects the resulting text buffer. The whole chain is ONE expansion (`expect_expansions`): the application is erased and typed once. Replayed by the shared engine on Linux, the macOS expander and the Windows engine; every driver must reach the same buffer.",
	"field_semantics": {
		"rules": "Registered hotstrings. auto: fires on its own last character (the * flag); otherwise it needs an end character. word_start: only fires at the start of a word (the engine's is_word); false lets it fire inside a word. case_sensitive: the typed case must match. Without case_sensitive a rule is in conform mode (the output takes the typed casing), so an uppercase output needs case_sensitive.",
		"max_arrows": "hotstrings.cascade_max_arrows: the number of expansions (arrows) a chain may hold; 1 is a single expansion.",
		"end_char": "The delimiter typed after `typed`; empty for none.",
		"end_char_consumed": "Whether that delimiter is consumed (hotstrings.terminator_consume): swallowed instead of typed after the output.",
		"expect_buffer": "The text buffer after the expansion and the replayed end character.",
		"expect_expansions": "How many expansions reach the application (one erase-and-type each)."
	},
	"vectors": [
		{
			"id": "fb_space_three_arrows_keeps_the_space",
			"description": "fb then Space with the abbreviation and brand packs: fb gives facebook, facebook gives Facebook, and the typed Space lands once after the final text.",
			"rules": [
				{
					"trigger": "fb",
					"replacement": "facebook",
					"auto": false,
					"word_start": true
				},
				{
					"trigger": "facebook",
					"replacement": "Facebook",
					"auto": false,
					"word_start": true,
					"case_sensitive": true
				}
			],
			"max_arrows": 3,
			"typed": "fb",
			"end_char": " ",
			"end_char_consumed": false,
			"expect_buffer": "Facebook ",
			"expect_expansions": 1
		},
		{
			"id": "fb_space_consumed_swallows_the_space_once",
			"description": "The same chain with Space consumed: the chain gives the same text and the Space is swallowed once at the end.",
			"rules": [
				{
					"trigger": "fb",
					"replacement": "facebook",
					"auto": false,
					"word_start": true
				},
				{
					"trigger": "facebook",
					"replacement": "Facebook",
					"auto": false,
					"word_start": true,
					"case_sensitive": true
				}
			],
			"max_arrows": 3,
			"typed": "fb",
			"end_char": " ",
			"end_char_consumed": true,
			"expect_buffer": "Facebook",
			"expect_expansions": 1
		},
		{
