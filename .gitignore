*.luac
luac.out


# ============================================================
# Auto-generated runtime files (never committed)
# ============================================================

# Machine-specific config-dir bootstrap, written at first launch
static/ergopti_plus/windows/_generated/paths.toml
static/ergopti_plus/macos/_generated/paths.toml

# Forwarding stub written at runtime by EnsurePersonalShortcutsFile
static/ergopti_plus/windows/_generated/personal_shortcuts.ahk

# Dashboard prefetch sidecars, regenerated on every launch
static/ergopti_plus/windows/_generated/prefetch_metrics_typing.json
static/ergopti_plus/windows/_generated/prefetch_metrics_apps.json

# Corpus working copy produced by build scripts
static/corpus/modifie/


# ============================================================
# Build artefacts
# ============================================================

# Windows — compiled exe (released via GitHub Releases, never committed)
static/ergopti_plus/windows/ErgoptiPlus.exe
static/ergopti_plus/windows/ErgoptiPlus.ahk.exe

# Windows — static asset bundle for the compiled exe
static/ergopti_plus/windows/build/

# macOS — Swift Package Manager cache for the launcher
static/ergopti_plus/macos/launcher/.build/
static/ergopti_plus/macos/launcher/.swiftpm/
static/ergopti_plus/macos/launcher/Package.resolved

# Version sidecar regenerated by CI
static/version.json
version.json


# ============================================================
# Local developer config
# ============================================================
.claude/settings.local.json
.claude/worktrees/
.locale_work/
.scratch/
