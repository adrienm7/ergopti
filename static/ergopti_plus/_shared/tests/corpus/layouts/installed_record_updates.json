		{
			"id": "chained-update-remove-preserves-neighbors-not-owned-id",
			"source": "{\"schema_version\":1,\"layouts\":{\"sample\":{\"id\":\"sample\",\"sha256\":\"old\",\"version\":\"1\",\"future\":[null,[],false]},\"neighbor\":{\"id\":\"neighbor\",\"sha256\":\"kept\",\"version\":\"1\",\"future\":[]}},\"future_root\":null}",
			"operations": [
