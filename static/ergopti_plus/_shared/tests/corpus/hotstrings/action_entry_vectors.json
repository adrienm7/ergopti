	"matches": [
		{
			"id": "auto_workflow_erases",
			"line": "\";wf1\" = { action = \"run_workflow\", workflow = \"wf_a\", auto_expand = true }",
			"typed": ";wf1",
			"expected": {
				"backspace_count": 4,
				"replacement": "",
				"action": "run_workflow",
				"workflow": "wf_a",
				"erase_trigger": true
			}
		},
		{
			"id": "word_keeps_text_and_end_char",
			"line": "\"bonjour\" = { action = \"select_all\", erase_trigger = false, is_word = true }",
			"typed": "bonjour",
			"terminator": " ",
			"expected": {
				"backspace_count": 0,
				"replacement": "",
				"action": "select_all",
				"erase_trigger": false,
				"replay_terminator": null
			}
		},
		{
			"id": "word_erases_and_replays_end_char",
			"line": "\"bonjour\" = { action = \"select_all\", is_word = true }",
			"typed": "bonjour",
			"terminator": " ",
			"expected": {
				"backspace_count": 8,
				"replacement": "",
				"action": "select_all",
				"erase_trigger": true,
				"replay_terminator": " "
			}
		},
		{
			"id": "output_with_action",
			"line": "\";sig\" = { output = \"Best,\", action = \"select_all\", auto_expand = true }",
			"typed": ";sig",
			"expected": {
				"backspace_count": 4,
				"replacement": "Best,",
				"action": "select_all"
			}
		},
		{
			"id": "text_entry_has_no_action",
			"line": "\";a\" = { output = \"b\", auto_expand = true }",
			"typed": ";a",
			"expected": {
				"backspace_count": 2,
				"replacement": "b",
				"action": null
			}
		}
	],
	"saves": [
		{
			"name": "an action entry writes its action and workflow, never the default erase",
			"source": "[_meta]\nsections_order = [\"words\"]\n[[words]]\n\"hello\" = { output = \"Bonjour\", is_word = true, auto_expand = false, is_case_sensitive = false, final_result = false }\n",
			"model": {
				"sections_order": ["words"],
				"sections": {
					"words": {
						"entries": [
							{
								"trigger": "hello",
								"output": "",
								"is_word": true,
								"auto_expand": false,
								"is_case_sensitive": false,
								"final_result": false,
								"action": "run_workflow",
								"workflow": "wf_a"
							}
						]
					}
				}
			},
			"contains": ["action = \"run_workflow\"", "workflow = \"wf_a\""],
			"absent": ["erase_trigger"]
		},
		{
			"name": "a kept trigger is written as erase_trigger = false",
			"source": "[_meta]\nsections_order = [\"words\"]\n[[words]]\n\"hello\" = { output = \"Bonjour\", is_word = true, auto_expand = false, is_case_sensitive = false, final_result = false }\n",
			"model": {
				"sections_order": ["words"],
				"sections": {
					"words": {
						"entries": [
							{
								"trigger": "hello",
								"output": "",
								"is_word": true,
								"auto_expand": false,
								"is_case_sensitive": false,
								"final_result": false,
								"action": "select_all",
								"erase_trigger": false
							}
						]
					}
				}
			},
			"contains": ["action = \"select_all\"", "erase_trigger = false"]
		},
		{
			"name": "clearing the action drops its fields from the source",
			"source": "[_meta]\nsections_order = [\"words\"]\n[[words]]\n\"hello\" = { output = \"\", is_word = true, auto_expand = false, is_case_sensitive = false, final_result = false, action = \"select_all\", erase_trigger = false }\n",
			"model": {
				"sections_order": ["words"],
				"sections": {
					"words": {
						"entries": [
							{
								"trigger": "hello",
								"output": "Bonjour",
								"is_word": true,
								"auto_expand": false,
								"is_case_sensitive": false,
								"final_result": false
							}
						]
					}
				}
			},
			"contains": ["output = \"Bonjour\""],
			"absent": ["action", "erase_trigger"]
		},
		{
			"name": "an invalid action refuses the save",
			"source": "[_meta]\nsections_order = [\"words\"]\n[[words]]\n\"hello\" = { output = \"Bonjour\", is_word = true, auto_expand = false, is_case_sensitive = false, final_result = false }\n",
			"model": {
				"sections_order": ["words"],
				"sections": {
					"words": {
						"entries": [
							{
								"trigger": "hello",
								"output": "",
								"is_word": true,
								"auto_expand": false,
								"is_case_sensitive": false,
								"final_result": false,
								"action": "Bad Action"
							}
						]
					}
				}
			},
			"refusal": "invalid-personal-row"
		}
	]
}
