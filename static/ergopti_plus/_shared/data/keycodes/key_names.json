{
	"_comment": "The one table naming a keyboard key or modifier in visible text, on every driver and web page. `keys` maps each key id to the locale key of its human name; `platforms` names the locale key a driver shows instead, where that OS calls the key otherwise (Option for Alt on macOS, Super for the system key on Linux). `macos_symbol` is the glyph the macOS menus draw for a modifier where they already use symbols (⌃⇧⌥⌘), one spelling for every such place. `aliases` maps every other spelling a driver, a config file or a slot id uses to its key id. tools/codegen/codegen-key-names.cjs projects it for Lua and AutoHotkey; tools/test/test-key-names-single-source.cjs holds the projections, the catalogue and the 21 locales to it. Keycap legends drawn on a keyboard picture (layer_editor.key.*) are short on purpose and are not row text.",
	"keys": {
		"escape": { "i18n": "key_name.escape" },
		"tab": { "i18n": "key_name.tab" },
		"caps_lock": { "i18n": "key_name.caps_lock" },
		"enter": { "i18n": "key_name.enter" },
		"space": { "i18n": "key_name.space" },
		"backspace": { "i18n": "key_name.backspace" },
		"delete": { "i18n": "key_name.delete" },
		"fn": { "i18n": "key_name.fn" },
		"shift": { "i18n": "key_name.shift", "macos_symbol": "⇧" },
		"left_shift": { "i18n": "key_name.left_shift" },
		"right_shift": { "i18n": "key_name.right_shift" },
		"ctrl": { "i18n": "key_name.ctrl", "macos_symbol": "⌃" },
		"left_ctrl": { "i18n": "key_name.left_ctrl" },
		"right_ctrl": { "i18n": "key_name.right_ctrl" },
		"alt": {
			"i18n": "key_name.alt",
			"platforms": { "macos": "key_name.option" },
			"macos_symbol": "⌥"
		},
		"left_alt": { "i18n": "key_name.left_alt", "platforms": { "macos": "key_name.left_option" } },
		"alt_gr": { "i18n": "key_name.alt_gr" },
		"win": { "i18n": "key_name.win", "platforms": { "linux": "key_name.super" } },
		"super": { "i18n": "key_name.super" },
		"cmd": { "i18n": "key_name.cmd", "macos_symbol": "⌘" },
		"left_command": { "i18n": "key_name.left_command" },
		"right_command": { "i18n": "key_name.right_command" },
		"option": { "i18n": "key_name.option", "macos_symbol": "⌥" },
		"left_option": { "i18n": "key_name.left_option" },
		"right_option": { "i18n": "key_name.right_option" }
	},
	"aliases": {
		"esc": "escape",
		"capslock": "caps_lock",
		"caps": "caps_lock",
		"return": "enter",
		"return_or_enter": "enter",
		"spacebar": "space",
		"delete_or_backspace": "backspace",
		"lshift": "left_shift",
		"rshift": "right_shift",
		"control": "ctrl",
		"lctrl": "left_ctrl",
		"rctrl": "right_ctrl",
		"left_control": "left_ctrl",
		"right_control": "right_ctrl",
		"lalt": "left_alt",
		"ralt": "alt_gr",
		"altgr": "alt_gr",
		"lwin": "win",
		"meta": "super",
		"command": "cmd",
		"left_cmd": "left_command",
		"right_cmd": "right_command"
	},
	"platforms": ["windows", "macos", "linux"]
}
