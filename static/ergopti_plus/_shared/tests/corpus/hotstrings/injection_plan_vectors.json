				"event_len": 1,
				"event_on_screen": false,
				"nbsp_stripped": true,
				"replacement": "ok",
				"terminator": ";",
				"consume_terminator": false
			},
			"expect": {
				"erase": 3,
				"text": "ok",
				"tail": ";",
				"replay": { "kind": "text", "chars": ";" },
				"buffer_suffix": "ok;",
				"final_result": false
			}
		},
		{
			"id": "terminator-extra-nbsp-on-screen",
			"input": {
