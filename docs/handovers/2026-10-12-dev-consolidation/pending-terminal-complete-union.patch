+			assert(ErgoptiOutput_SerializeAttempt(&o, OWNER, &key, attempt, packets, 6, &count) == 0);
+			assert(count == total && memcmp(&retained, &o, sizeof(o)) == 0);
+			for (uint32_t i = 0; i < count; ++i)
