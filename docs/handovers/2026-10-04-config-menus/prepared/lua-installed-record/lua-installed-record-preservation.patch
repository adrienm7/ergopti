+					helpers.assert_eq(result.ok, false)
+					helpers.assert_eq(result.detail, registry.FAILURE_RECORD)
+					helpers.assert_eq(read_source(), text)
+					helpers.assert_eq(write_count(), 0)
+					helpers.assert_eq(#state.deleted, 0)
+				end)
+			end
+		end)
+	end)
+end
