{
	"cases": [
		{
			"name": "forward slot",
			"symmetric": false,
			"first": "caps_lock",
			"second": "tab",
			"elapsed": 10,
			"expected": "copy",
			"pair": "caps_lock_then_tab"
		},
		{
			"name": "reverse distinct slot",
			"symmetric": false,
			"first": "tab",
			"second": "caps_lock",
			"elapsed": 10,
			"expected": "paste",
			"pair": "tab_then_caps_lock"
		},
		{
			"name": "symmetric earlier forward owner",
			"symmetric": true,
			"first": "tab",
			"second": "caps_lock",
			"elapsed": 10,
			"expected": "copy",
			"pair": "caps_lock_then_tab"
		},
		{
			"name": "inclusive deadline",
			"symmetric": false,
			"first": "caps_lock",
			"second": "tab",
			"elapsed": 100,
			"expected": "copy",
			"pair": "caps_lock_then_tab"
		},
		{
			"name": "after deadline",
			"symmetric": false,
			"first": "caps_lock",
			"second": "tab",
			"elapsed": 100.001,
			"expected": false
		},
		{
			"name": "negative elapsed",
			"symmetric": false,
			"first": "caps_lock",
			"second": "tab",
			"elapsed": -1,
			"expected": false
		},
		{
			"name": "unknown first",
			"symmetric": false,
			"first": "escape",
			"second": "tab",
			"elapsed": 0,
			"expected": false
		},
		{
			"name": "same key is not a chord",
			"symmetric": false,
			"first": "tab",
			"second": "tab",
			"elapsed": 0,
			"expected": false
		}
	]
}
