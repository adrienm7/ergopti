{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://ergopti.com/schema/manifest.schema.json",
	"title": "Ergopti+ features manifest",
	"description": "JSON Schema for _shared/features/manifest.toml — the single source of truth that drives first-boot config generation and tray-menu rendering in both drivers.",
	"type": "object",
	"additionalProperties": false,
	"required": ["manifest", "sections", "features"],

	"properties": {
		"manifest": { "$ref": "#/$defs/manifest_meta" },
		"sections": { "$ref": "#/$defs/sections_root" },
		"features": { "$ref": "#/$defs/features_root" }
	},

	"$defs": {

		"manifest_meta": {
			"type": "object",
			"additionalProperties": false,
			"required": ["version"],
			"properties": {
				"version":       { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
				"config_schema": { "type": "string", "format": "uri" }
			}
		},

		"sections_root": {
			"description": "Top-level sections registry. Keys are section names; nested tables follow the same shape recursively.",
			"type": "object",
			"properties": {
				"order": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Ordered list of top-level section names; drives both menu order and config.toml emission order."
				}
			},
			"additionalProperties": { "$ref": "#/$defs/section_node" }
		},

		"section_node": {
			"description": "Metadata for a single section path. Nested sub-section tables appear as further keys on this same table.",
			"type": "object",
			"properties": {
				"description_key": { "type": "string" },
				"platforms": {
					"type": "array",
					"items": { "enum": ["ahk", "hs"] },
					"minItems": 1,
					"uniqueItems": true
				},
				"subsections": {
					"type": "array",
					"items": { "type": "string" },
					"description": "Ordered list of child section names for menu/render ordering."
				}
			},
			"required": ["description_key"],
			"additionalProperties": { "$ref": "#/$defs/section_node" }
		},

		"features_root": {
			"description": "Top-level features registry. Keys are section paths (dot-separated mirrored as nested tables); values are arrays-of-tables of feature entries.",
			"type": "object",
			"additionalProperties": {
				"oneOf": [
					{ "type": "array", "items": { "$ref": "#/$defs/feature_entry" } },
					{ "$ref": "#/$defs/features_root" }
				]
			}
		},

		"feature_entry": {
			"type": "object",
			"additionalProperties": false,
			"required": ["id", "description_key"],
			"properties": {
				"id":              { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
				"default":         { "description": "Primitive (bool/number/string/array) OR table. Mutually optional with default_per_platform — exactly one of them must be set." },
				"default_per_platform": {
					"type": "object",
					"additionalProperties": false,
					"properties": {
						"ahk": {},
						"hs":  {}
					},
					"description": "Per-platform default value. Use only when the default legitimately differs per driver."
				},
				"type": {
					"enum": ["boolean", "enum", "string", "number", "array", "action", "feature"]
				},
				"enum_values": {
					"type": "array",
					"minItems": 1,
					"description": "Required when type = \"enum\"."
				},
				"description_key": { "type": "string" },
				"platforms": {
					"type": "array",
					"items": { "enum": ["ahk", "hs"] },
					"minItems": 1,
					"uniqueItems": true
				}
			},

			"oneOf": [
				{ "required": ["default"] },
				{ "required": ["default_per_platform"] }
			],

			"allOf": [
				{
					"if":   { "properties": { "type": { "const": "enum" } }, "required": ["type"] },
					"then": { "required": ["enum_values"] }
				}
			]
		}
	}
}
