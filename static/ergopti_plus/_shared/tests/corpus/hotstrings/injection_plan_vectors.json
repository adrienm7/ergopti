{
	"schema": 1,
	"description": "What each hotstring engine erases, types and replays, per completed match. Both drivers replay it through hotstring_engine.injection_plan. event_on_screen is the one driver-dependent input: Linux is always true; macOS is false unless the window is ignored. A divergence between drivers would be recorded in `divergence` (none today).",
	"vectors": [
		{
			"id": "auto-held-event",
			"input": {
				"path": "auto",
				"trigger_len": 3,
				"event_len": 1,
				"event_on_screen": false,
				"replacement": "xyz"
			},
			"expect": {
				"erase": 2,
				"text": "xyz",
				"tail": null,
				"replay": null,
				"buffer_suffix": "xyz",
				"final_result": false
			}
		},
		{
			"id": "auto-event-on-screen",
			"input": {
				"path": "auto",
				"trigger_len": 3,
				"event_len": 1,
				"event_on_screen": true,
				"replacement": "xyz"
			},
			"expect": {
				"erase": 3,
				"text": "xyz",
				"tail": null,
				"replay": null,
				"buffer_suffix": "xyz",
				"final_result": false
			}
		},
		{
			"id": "auto-composed-event-clamps-at-zero",
			"input": {
				"path": "auto",
				"trigger_len": 1,
				"event_len": 2,
				"event_on_screen": false,
				"replacement": "é"
			},
			"expect": {
				"erase": 0,
				"text": "é",
				"tail": null,
				"replay": null,
				"buffer_suffix": "é",
				"final_result": false
			}
		},
		{
			"id": "auto-ignores-a-stray-terminator",
			"input": {
				"path": "auto",
				"trigger_len": 2,
				"event_len": 1,
				"event_on_screen": true,
				"replacement": "ab",
				"terminator": " ",
				"consume_terminator": false
			},
			"expect": {
				"erase": 2,
				"text": "ab",
				"tail": null,
				"replay": null,
				"buffer_suffix": "ab",
				"final_result": false
			}
		},
		{
			"id": "terminator-held-event",
			"input": {
				"path": "terminator",
				"trigger_len": 4,
				"event_len": 1,
				"event_on_screen": false,
				"replacement": "word",
				"terminator": " ",
				"consume_terminator": false
			},
			"expect": {
				"erase": 4,
				"text": "word",
				"tail": " ",
				"replay": { "kind": "text", "chars": " " },
				"buffer_suffix": "word ",
				"final_result": false
			}
		},
		{
			"id": "terminator-ignored-window-erases-the-event",
			"input": {
				"path": "terminator",
				"trigger_len": 4,
				"event_len": 1,
				"event_on_screen": true,
				"replacement": "word",
				"terminator": " ",
				"consume_terminator": false
			},
			"expect": {
				"erase": 5,
				"text": "word",
				"tail": " ",
				"replay": { "kind": "text", "chars": " " },
				"buffer_suffix": "word ",
				"final_result": false
			}
		},
