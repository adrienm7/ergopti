			"output": "if (a) { b }",
			"tokens": [{ "text": "if (a) { b }" }],
			"text": "if (a) { b }",
			"has_keys": false
		},
		{
			"id": "send-metacharacters-are-text",
			"output": "c++ !a #b ^c ~d{Left}",
			"tokens": [{ "text": "c++ !a #b ^c ~d" }, { "key": "left", "count": 1 }],
			"text": "c++ !a #b ^c ~d",
			"has_keys": true
		},
