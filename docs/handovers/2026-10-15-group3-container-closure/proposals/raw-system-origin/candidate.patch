+/** Original native scan projection, with origin chosen from the full tuple. */
+static ErgoptiReplay_Event RawEdge(
+	uint32_t vk, uint32_t raw_scan, uint32_t flags, uint64_t timestamp)
+{
+	ErgoptiReplay_Event event = {0};
+	event.timestamp = timestamp;
+	event.source_id = 1;
+	event.vk = (uint16_t)vk;
+	event.scan = (uint16_t)(raw_scan & 0xFFu);
+	if ((flags & 1u) != 0)
+		event.scan |= 0x100u;
+	event.key_up = (flags & 0x80u) != 0;
+	event.origin = ErgoptiReplay_RawHookOrigin(vk, raw_scan, flags);
+	return event;
+}
+
+/** Literal real-modifier holds must survive each driver's synthetic UP. */
+static void TestRawSystemOriginDoesNotRetireUserHold(void)
+{
+	static const struct {
+		uint32_t vk;
+		uint32_t real_scan;
+		uint32_t synthetic_scan;
+		uint8_t effective_mask;
+	} cases[] = {
+		{0xA2, 0x1D, 0x21D, 0x04},
+		{0xA0, 0x2A, 0x22A, 0x10},
+		{0xA1, 0x36, 0x236, 0x20}
+	};
+	size_t i;
+	for (i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i) {
+		ErgoptiReplay_State state, retained;
+		ErgoptiReplay_Snapshot snapshot;
+		ErgoptiReplay_Event event;
+		int32_t status;
+		Start(&state);
+		event = RawEdge(cases[i].vk, cases[i].real_scan, 0, 1);
+		assert(ErgoptiReplay_Step(&state, OWNER, &event, &snapshot) == ERGOPTI_REPLAY_OK);
+		assert(snapshot.modifiers_lr_after == cases[i].effective_mask);
+		retained = state;
+		event = RawEdge(cases[i].vk, cases[i].synthetic_scan, 0x80, 2);
+		/* These two raw identities really do collide after the old projection. */
+		assert(event.scan == cases[i].real_scan);
+		status = ErgoptiReplay_Step(&state, OWNER, &event, &snapshot);
+		/* Check the real state before status, so legacy code fails on actual
+		 * lost ownership rather than an absent new enum/API assertion. */
+		assert(memcmp(&retained, &state, sizeof(state)) == 0);
+		assert(status == ERGOPTI_REPLAY_UNSUPPORTED);
+		assert(snapshot.modifiers_lr_before == cases[i].effective_mask);
+		assert(snapshot.modifiers_lr_after == cases[i].effective_mask);
+		event = RawEdge(cases[i].vk, cases[i].synthetic_scan, 0, 3);
+		assert(ErgoptiReplay_Step(&state, OWNER, &event, &snapshot) == ERGOPTI_REPLAY_UNSUPPORTED);
+		assert(memcmp(&retained, &state, sizeof(state)) == 0);
+		event = RawEdge(cases[i].vk, cases[i].real_scan, 0x80, 4);
+		assert(ErgoptiReplay_Step(&state, OWNER, &event, &snapshot) == ERGOPTI_REPLAY_OK);
+		assert(snapshot.modifiers_lr_before == cases[i].effective_mask);
+		assert(snapshot.modifiers_lr_after == 0);
+	}
+	puts("PASS raw keyboard-driver synthetic Ctrl/Shift cannot retire retained real modifier recipes.");
+}
+
+/** Known injection and unmodeled raw bits never become physical recipes. */
+static void TestRawOriginDowngradesOnly(void)
+{
+	static const struct {
+		uint32_t vk, scan, flags;
+		uint8_t expected;
+	} cases[] = {
+		{0xA2, 0x1D, 0, ERGOPTI_REPLAY_PHYSICAL},
+		{0xA3, 0x1D, 1, ERGOPTI_REPLAY_PHYSICAL},
+		{0xA2, 0x21D, 0x10, ERGOPTI_REPLAY_EXTERNAL_INJECTION},
+		{0xA2, 0x21D, 0x12, ERGOPTI_REPLAY_LOWER_INTEGRITY},
+		{0xA2, 0x1D, 0x02, ERGOPTI_REPLAY_LOWER_INTEGRITY},
+		{0xA2, 0xE01D, 0, 5},
+		{0xA2, 0x1D, 0x80000000u, 5},
+		{0x1A2, 0x1D, 0, 5},
+		{0xA2, 0, 0, 5},
+		{0, 0x1D, 0, 5}
+	};
+	size_t i;
+	for (i = 0; i < sizeof(cases) / sizeof(cases[0]); ++i)
+		assert(ErgoptiReplay_RawHookOrigin(cases[i].vk, cases[i].scan, cases[i].flags) == cases[i].expected);
+	puts("PASS full raw scan/flag classification preserves injection refusal and conservative unknowns.");
+}
