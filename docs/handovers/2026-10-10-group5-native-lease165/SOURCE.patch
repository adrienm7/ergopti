+const terminal = (name) => `Test Case '${name}' passed (0.001 seconds).`;
+const lines = [
+	`Test Suite 'Selected tests' started at ${stamp}`,
+	`Test Suite 'ErgoptiPlusPackageTests.xctest' started at ${stamp}`
+];
